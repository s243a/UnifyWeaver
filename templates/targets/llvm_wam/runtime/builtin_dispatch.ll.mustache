  store i32 2, i32* %pkv.r_p_ar_slot
  %pkv.r_p_args_mem = call i8* @wam_arena_alloc(i64 32)
  %pkv.r_p_args = bitcast i8* %pkv.r_p_args_mem to %Value*
  %pkv.r_p_args_slot = getelementptr %Compound, %Compound* %pkv.r_p_cp, i32 0, i32 2

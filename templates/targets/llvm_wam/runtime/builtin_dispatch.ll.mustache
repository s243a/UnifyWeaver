  %gt.t2 = extractvalue %Value %gt.e2, 0
  %gt.f1 = icmp eq i32 %gt.t1, 2
  %gt.f2 = icmp eq i32 %gt.t2, 2
  %gt.eitherf = or i1 %gt.f1, %gt.f2

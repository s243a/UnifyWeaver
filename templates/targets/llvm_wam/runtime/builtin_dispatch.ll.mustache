  %alc3.s_c_adv = select i1 %alc3.s_c_matched, i64 %alc3.smn, i64 1
  %alc3.s_c_i_next = add i64 %alc3.s_c_i, %alc3.s_c_adv
  %alc3.s_c_inc32 = zext i1 %alc3.s_c_matched to i32

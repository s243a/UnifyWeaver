pkv.r_build_init:
  %pkv.r_b_empty_id = load i64, i64* @wam_empty_list_atom_id
  %pkv.r_b_empty_v0 = insertvalue %Value undef, i32 0, 0
  %pkv.r_b_empty_v  = insertvalue %Value %pkv.r_b_empty_v0, i64 %pkv.r_b_empty_id, 1

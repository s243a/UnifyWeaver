  %alc3.s_a3_tag = extractvalue %Value %alc3.s_a3, 0
  %alc3.s_a3_is_atom = icmp eq i32 %alc3.s_a3_tag, 0
  br i1 %alc3.s_a3_is_atom, label %alc3.s_a3_str, label %alc3.fail

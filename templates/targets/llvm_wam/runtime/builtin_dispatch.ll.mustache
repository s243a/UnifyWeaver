  ; RLIMIT_NICE), EACCES, etc. fail.
  %spr.a1 = call %Value @wam_get_reg_deref(%WamState* %vm, i32 0)
  %spr.t1 = call i32 @value_tag(%Value %spr.a1)
  %spr.is_int = icmp eq i32 %spr.t1, 1

  ; from -1-as-error without errno. Inc must be Integer.
  %nic.a1 = call %Value @wam_get_reg_deref(%WamState* %vm, i32 0)
  %nic.t1 = call i32 @value_tag(%Value %nic.a1)
  %nic.is_int = icmp eq i32 %nic.t1, 1

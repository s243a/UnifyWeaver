  %alc.f_off = phi i64 [ 0, %alc.c_done ], [ %alc.f_off1, %alc.f_after ]
  %alc.f_d = call %Value @wam_deref_value(%WamState* %vm, %Value %alc.f_cur)
  %alc.f_tag = extractvalue %Value %alc.f_d, 0

  %alc3.s_amn = phi i64 [ 0, %alc3.s_a3_str ], [ %alc3.s_amn1, %alc3.s_amstep ]
  %alc3.s_amc = load i8, i8* %alc3.s_amp
  %alc3.s_amz = icmp eq i8 %alc3.s_amc, 0

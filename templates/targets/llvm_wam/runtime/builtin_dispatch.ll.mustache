  %grl.buf_ptr = getelementptr [16 x i8], [16 x i8]* %grl.buf, i32 0, i32 0
  %grl.ret = call i32 @getrlimit(i32 %grl.res, i8* %grl.buf_ptr)
  %grl.call_ok = icmp eq i32 %grl.ret, 0
  br i1 %grl.call_ok, label %grl.read, label %grl.fail

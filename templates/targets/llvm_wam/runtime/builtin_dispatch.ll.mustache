  store i8 116, i8* %tmpf.b1
  %tmpf.b2 = getelementptr i8, i8* %tmpf.buf_ptr, i64 2
  store i8 109, i8* %tmpf.b2
  %tmpf.b3 = getelementptr i8, i8* %tmpf.buf_ptr, i64 3
  store i8 112, i8* %tmpf.b3

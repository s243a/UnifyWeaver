  %prss.buf_ptr = getelementptr [256 x i8], [256 x i8]* %prss.buf, i32 0, i32 0
  %prss.ret = call i32 @getrusage(i32 0, i8* %prss.buf_ptr)
  %prss.ok = icmp eq i32 %prss.ret, 0

  %atc.bufsize = add i64 %atc.total, 1
  %atc.buf = call i8* @wam_arena_alloc(i64 %atc.bufsize)
  call void @llvm.memcpy.p0i8.p0i8.i64(i8* %atc.buf, i8* %atc.s1, i64 %atc.m1_n, i1 false)

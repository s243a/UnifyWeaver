  ; equal length; build pair_arr of -/2 compounds; cons-chain it;
  ; unify A1.
  %pkv.r_a2 = call %Value @wam_get_reg_deref(%WamState* %vm, i32 1)
  %pkv.r_a3 = call %Value @wam_get_reg_deref(%WamState* %vm, i32 2)

  %grl.cur = load i64, i64* %grl.cur_ptr
  %grl.v = call %Value @value_integer(i64 %grl.cur)
  %grl.raw2 = call %Value @wam_get_reg(%WamState* %vm, i32 1)
  %grl.ok = call i1 @wam_unify_value(%WamState* %vm, %Value %grl.raw2, %Value %grl.v)
  ret i1 %grl.ok


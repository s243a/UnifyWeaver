  ret i1 false
mkf.check2:
  %mkf.a2 = call %Value @wam_get_reg_deref(%WamState* %vm, i32 1)
  %mkf.t2 = call i32 @value_tag(%Value %mkf.a2)
  %mkf.is_int = icmp eq i32 %mkf.t2, 1
  br i1 %mkf.is_int, label %mkf.go, label %mkf.fail

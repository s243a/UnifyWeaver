  %nco.f_raw2 = call %Value @wam_get_reg(%WamState* %vm, i32 1)
  %nco.f_uok = call i1 @wam_unify_value(%WamState* %vm, %Value %nco.f_raw2, %Value %nco.f_btail)
  ret i1 %nco.f_uok

nco.rev_init:

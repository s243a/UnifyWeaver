le.arith_failed:
  ret i1 false
le.arith_ok:
  %le.t1 = extractvalue %Value %le.e1, 0
  %le.t2 = extractvalue %Value %le.e2, 0
  %le.f1 = icmp eq i32 %le.t1, 2
  %le.f2 = icmp eq i32 %le.t2, 2

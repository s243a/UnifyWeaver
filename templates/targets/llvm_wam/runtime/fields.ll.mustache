  %fsc.len_gt = icmp ugt i64 %fsc.len, %lit_len
  %fsc.len_sign0 = select i1 %fsc.len_gt, i64 1, i64 0
  %fsc.len_sign = select i1 %fsc.len_lt, i64 -1, i64 %fsc.len_sign0

  store %WamEntryRow* %entRows, %WamEntryRow** %vm_ent_ptr
  %vm_entc_ptr = getelementptr %WamState, %WamState* %vm, i32 0, i32 29
  %nent32 = trunc i64 %nentries to i32
  store i32 %nent32, i32* %vm_entc_ptr

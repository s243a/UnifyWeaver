  store i64 %sbits, i64* %slot_s
  store i64 %slen, i64* %len_slot
  br label %fstep_ok
fstep_ok:
  %fi1 = add i32 %fi, 1
  br label %floop
ok_rewind:
  store i32 %hs_saved, i32* %hs_ptr
  call void @wam_cleanup()
  ret i1 true
rewind_fail:
  store i32 %hs_saved, i32* %hs_ptr
  call void @wam_cleanup()
  br label %fail
fail:

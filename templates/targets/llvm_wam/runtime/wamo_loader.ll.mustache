  %ret1 = insertvalue { %WamState*, i32 } %ret0, i32 %entry_pc, 1
  ret { %WamState*, i32 } %ret1
fail:
  %fnull = insertvalue { %WamState*, i32 } undef, %WamState* null, 0
  %fret = insertvalue { %WamState*, i32 } %fnull, i32 0, 1
  ret { %WamState*, i32 } %fret

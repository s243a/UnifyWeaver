    /// Are these the SAME view of the same allocation? Used to detect "nothing
    /// changed" without comparing contents; `false` is always safe.
    #[inline]
    pub fn same_ref(a: &Args, b: &Args) -> bool {
        a.off == b.off && Arc::ptr_eq(&a.spine, &b.spine)

    pub fn is_full_view(&self) -> bool {
        self.off == 0
    }

    /// The deref-stability tristate of the full spine (0/1/2). `deref_heap`
    /// short-circuits on `1` and skips re-checking on `2`.
    #[cfg(feature = "deref_memo")]
    #[inline]
    pub fn stability(&self) -> u8 {
        self.spine.stable.load(Ordering::Relaxed)
    }

    /// True iff the full spine is proven deref-stable (state `1`).
    #[cfg(feature = "deref_memo")]
    #[inline]
    pub fn is_full_stable(&self) -> bool {
        self.stability() == 1
    }

    /// Record that the full spine is deref-stable. Only call from
    /// `deref_heap`'s verified identity path on a full view (`off == 0`) whose
    /// every element is deref-stable.
    #[cfg(feature = "deref_memo")]
    #[inline]
    pub fn mark_stable(&self) {
        self.spine.stable.store(1, Ordering::Relaxed);
    }

    /// Record that the full spine is NOT deref-stable (a permanent property of
    /// the immutable spine — an element moved, or an element is never
    /// deref-stable). Skips the stability re-check on later derefs.
    #[cfg(feature = "deref_memo")]
    #[inline]
    pub fn mark_not_stable(&self) {
        self.spine.stable.store(2, Ordering::Relaxed);
    }
}

impl Deref for Args {
    type Target = [Value];
    #[inline]
    fn deref(&self) -> &[Value] {
        &self.spine.items[self.off..]
    }
}

impl From<Vec<Value>> for Args {
    #[inline]
    fn from(items: Vec<Value>) -> Args {
        Args::from_vec(items)
    }
}

impl PartialEq for Args {
    #[inline]
    fn eq(&self, other: &Args) -> bool {
        Self::same_ref(self, other) || **self == **other
    }
}

/// Universal value type for the WAM runtime.
/// Mirrors the Prolog term universe used by wam_runtime.pl.
#[derive(Clone, Debug)]
pub enum Value {
    /// Atomic symbol (Prolog atom) — name interned (see `Sym`).
    Atom(Sym),
    /// Integer value
    Integer(i64),
    /// Floating point value
    Float(f64),
    /// Compound term: functor name (interned) + shared sub-argument spine
    Str(Sym, Args),
    /// List value (Prolog list), shared spine
    List(Args),
    /// Heap reference (from put_structure/put_list)
    Ref(usize),
    /// Unbound variable (e.g., _V5, _H3) — name interned (see `Sym`).
    Unbound(Sym),
    /// Boolean value
    Bool(bool),
    /// Uninitialized register slot -- zero-cost sentinel for the register file.
    /// Never appears in Prolog terms; only used internally by WamState.
    Uninit,
}

impl Value {
    /// First-argument index key for T9 fact tables: a type-tagged canonical
    /// string for an atomic value (atom / integer / float), or None for
    /// compound / list / unbound / ref values (which can only match via a full
    /// scan). The same function keys both the stored rows and the query arg, so
    /// a bound atomic first argument selects exactly the matching index bucket.
    pub fn fact_index_key(&self) -> Option<String> {
        match self {
            Value::Atom(s) => Some(format!("a:{}", s)),
            Value::Integer(n) => Some(format!("i:{}", n)),
            Value::Float(f) => Some(format!("f:{}", f)),
            _ => None,
        }
    }

    /// Check if this value is an unbound WAM variable.
    /// Corresponds to is_unbound_var/1 in wam_runtime.pl.
    pub fn is_unbound(&self) -> bool {
        matches!(self, Value::Unbound(_))
    }

    /// Check if this value is a number (integer or float).
    pub fn is_number(&self) -> bool {
        matches!(self, Value::Integer(_) | Value::Float(_))
    }

    /// Check if this value is a compound term.
    pub fn is_compound(&self) -> bool {
        matches!(self, Value::Str(_, _))
    }

    /// Check if this value is a list.
    pub fn is_list(&self) -> bool {
        matches!(self, Value::List(_))
    }

    /// Extract integer value, panicking if not an integer.
    pub fn as_int(&self) -> i64 {
        match self {
            Value::Integer(n) => *n,
            _ => panic!("Expected integer, got {:?}", self),
        }
    }

    /// Extract float value, coercing integers.
    pub fn as_float(&self) -> f64 {
        match self {
            Value::Float(f) => *f,
            Value::Integer(n) => *n as f64,
            _ => panic!("Expected number, got {:?}", self),
        }
    }

    /// Extract atom string, panicking if not an atom.
    pub fn as_atom(&self) -> &str {
        match self {
            Value::Atom(s) => s.as_str(),
            _ => panic!("Expected atom, got {:?}", self),
        }
    }

    /// Decompose a compound term (=../2 equivalent).
    /// Returns (functor, args) or None for non-compound values.
    pub fn univ(&self) -> Option<(&str, &[Value])> {
        match self {
            Value::Str(f, args) => Some((f.as_str(), args)),
            _ => None,
        }
    }

    /// Construct a compound term from functor and args.
    pub fn make_str(functor: &str, args: Vec<Value>) -> Value {
        Value::Str(functor.into(), Args::from_vec(args))
    }

    /// Construct an atom from anything nameable (interns the name under the
    /// `intern` feature; an owned `String` on the pre-intern path). This is the
    /// construction helper the generator/runtime route atom construction
    /// through so the name representation is single-sourced.
    #[inline]
    pub fn atom(name: impl Into<Sym>) -> Value {
        Value::Atom(name.into())
    }

    /// Construct an unbound variable from anything nameable.
    #[inline]
    pub fn unbound(name: impl Into<Sym>) -> Value {
        Value::Unbound(name.into())
    }

    /// Construct a compound term from a nameable functor and a shared spine.
    #[inline]
    pub fn str_sym(functor: impl Into<Sym>, args: Args) -> Value {
        Value::Str(functor.into(), args)
    }

    /// Construct a list from an owned `Vec` (structural-sharing constructor).
    /// `Value::List` itself takes the shared `Args` spine; this is the
    /// convenience form for the many sites that build a fresh vector.
    #[inline]
    pub fn list(items: Vec<Value>) -> Value {
        Value::List(Args::from_vec(items))
    }

    /// Construct a compound term from an owned functor `String` and an owned
    /// `Vec` of arguments (structural-sharing constructor).
    #[inline]
    pub fn strv(functor: impl Into<Sym>, args: Vec<Value>) -> Value {
        Value::Str(functor.into(), Args::from_vec(args))
    }


    /// Create a new unbound variable with the given name.
    pub fn new_unbound(name: &str) -> Value {
        Value::Unbound(name.into())
    }
}

impl PartialEq for Value {
    fn eq(&self, other: &Self) -> bool {
        match (self, other) {
            (Value::Atom(a), Value::Atom(b)) => a == b,
            (Value::Integer(a), Value::Integer(b)) => a == b,
            (Value::Float(a), Value::Float(b)) => a == b,
            (Value::Bool(a), Value::Bool(b)) => a == b,
            (Value::Str(f1, a1), Value::Str(f2, a2)) => f1 == f2 && a1 == a2,
            (Value::List(a), Value::List(b)) => a == b,
            (Value::Ref(a), Value::Ref(b)) => a == b,
            (Value::Unbound(a), Value::Unbound(b)) => a == b,
            (Value::Uninit, Value::Uninit) => true,
            _ => false,
        }
    }
}

impl fmt::Display for Value {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Value::Atom(s) => write!(f, "{}", s),
            Value::Integer(n) => write!(f, "{}", n),
            Value::Float(n) => write!(f, "{}", n),
            Value::Bool(b) => write!(f, "{}", b),
            Value::Str(func, args) => {
                write!(f, "{}(", func)?;
                for (i, arg) in args.iter().enumerate() {
                    if i > 0 { write!(f, ", ")?; }
                    write!(f, "{}", arg)?;
                }
                write!(f, ")")
            }
            Value::List(items) => {
                write!(f, "[")?;
                for (i, item) in items.iter().enumerate() {
                    if i > 0 { write!(f, ", ")?; }
                    write!(f, "{}", item)?;
                }
                write!(f, "]")
            }
            Value::Ref(addr) => write!(f, "ref({})", addr),
            Value::Unbound(name) => write!(f, "{}", name),
            Value::Uninit => write!(f, "_uninit_"),
        }
    }
}

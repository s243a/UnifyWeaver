// D43 bytes-read proof counters. Global (not per-source) so the scale probe
// can total the bytes read across all five stores in one query, exactly like
// the Go lane's package-level factIOBytes / factIOReads / factIODataSize.
static FACT_IO_BYTES: AtomicU64 = AtomicU64::new(0);
static FACT_IO_READS: AtomicU64 = AtomicU64::new(0);
static FACT_IO_DATA_SIZE: AtomicU64 = AtomicU64::new(0);

/// Bytes read off disk since the last reset (the D43 proof numerator).
pub fn fact_io_bytes() -> u64 {
    FACT_IO_BYTES.load(Ordering::Relaxed)
}

/// Positioned-read count since the last reset.
pub fn fact_io_reads() -> u64 {
    FACT_IO_READS.load(Ordering::Relaxed)
}

/// Size of the most-recently-opened .data blob (informational; the scale
/// probe totals all five .data sizes independently, as the Go shim does).
pub fn fact_io_data_size() -> u64 {
    FACT_IO_DATA_SIZE.load(Ordering::Relaxed)
}

/// Zero the bytes-read counters between runs.
pub fn reset_fact_io() {
    FACT_IO_BYTES.store(0, Ordering::Relaxed);
    FACT_IO_READS.store(0, Ordering::Relaxed);
    FACT_IO_DATA_SIZE.store(0, Ordering::Relaxed);
}

fn le_u16(b: &[u8], o: usize) -> usize {
    if o + 2 > b.len() {
        return 0;
    }
    (b[o] as usize) | ((b[o + 1] as usize) << 8)
}

fn le_u32(b: &[u8], o: usize) -> u32 {
    if o + 4 > b.len() {
        return 0;
    }
    (b[o] as u32) | ((b[o + 1] as u32) << 8) | ((b[o + 2] as u32) << 16) | ((b[o + 3] as u32) << 24)
}

fn bytes_compare(a: &[u8], b: &[u8]) -> i32 {
    let n = a.len().min(b.len());
    let mut i = 0;
    while i < n {
        if a[i] != b[i] {
            if a[i] < b[i] {
                return -1;
            }
            return 1;
        }
        i += 1;
    }
    if a.len() < b.len() {
        return -1;
    }
    if a.len() > b.len() {
        return 1;
    }
    0
}

/// One positioned read that feeds the D43 counters. Mirrors Go's factIORead:
/// on a short read it returns only the bytes actually read.
fn fact_io_read(f: &File, length: usize, position: u64) -> Vec<u8> {
    if length == 0 {
        return Vec::new();
    }
    let mut buf = vec![0u8; length];
    let n = f.read_at(&mut buf, position).unwrap_or(0);
    FACT_IO_BYTES.fetch_add(n as u64, Ordering::Relaxed);
    FACT_IO_READS.fetch_add(1, Ordering::Relaxed);
    buf.truncate(n);
    buf
}

fn is_ascii_digit(c: u8) -> bool {
    c >= 48 && c <= 57
}

fn is_int_text(t: &str) -> bool {
    let b = t.as_bytes();
    if b.is_empty() {
        return false;
    }
    let mut i = 0;
    if b[0] == 45 {
        if b.len() == 1 {
            return false;
        }
        i = 1;
    }
    while i < b.len() {
        if !is_ascii_digit(b[i]) {
            return false;
        }
        i += 1;
    }
    true
}

fn is_float_text(t: &str) -> bool {
    let mut s = t;
    if s.is_empty() {
        return false;
    }
    if s.as_bytes()[0] == 45 {
        s = &s[1..];
    }
    if s.is_empty() {
        return false;
    }
    let sb = s.as_bytes();
    let mut split = sb.len();
    let mut k = 0;
    while k < sb.len() {
        if sb[k] == 101 || sb[k] == 69 {
            split = k;
            break;
        }
        k += 1;
    }
    let has_exp = split != sb.len();
    let mant = &s[..split];
    let exp = if has_exp { &s[split + 1..] } else { "" };
    let mb = mant.as_bytes();
    let mut dot: i32 = -1;
    let mut j = 0;
    while j < mb.len() {
        let c = mb[j];
        if c == 46 {
            if dot >= 0 {
                return false;
            }
            dot = j as i32;
        } else if !is_ascii_digit(c) {
            return false;
        }
        j += 1;
    }
    if has_exp {
        if dot < 0 {
            if mant.is_empty() {
                return false;
            }
        } else {
            let d = dot as usize;
            let left = &mant[..d];
            let right = &mant[d + 1..];
            if left.is_empty() && right.is_empty() {
                return false;
            }
        }
        let mut e = exp;
        if e.is_empty() {
            return false;
        }
        let eb = e.as_bytes();
        if eb[0] == 43 || eb[0] == 45 {
            e = &e[1..];
        }
        if e.is_empty() {
            return false;
        }
        for c in e.as_bytes() {
            if !is_ascii_digit(*c) {
                return false;
            }
        }
        return true;
    }
    if dot < 0 {
        return false;
    }
    let d = dot as usize;
    let left = &mant[..d];
    let right = &mant[d + 1..];
    if left.is_empty() && right.is_empty() {
        return false;
    }
    true
}

/// Turn a stored cell text into a typed WAM value, matching the codec
/// classification (int / float / atom). The resolver store packs everything as
/// atoms; the numeric arms keep the distinctions for any store that carries
/// bare numbers. Mirrors Go's parseFactSourceValue.
pub fn parse_fact_source_value(text: &str) -> Value {
    let t = text.trim();
    if is_int_text(t) {
        if let Ok(n) = t.parse::<i64>() {
            return Value::Integer(n);
        }
    }
    if is_float_text(t) {
        if let Ok(f) = t.parse::<f64>() {
            return Value::Float(f);
        }
    }
    Value::Atom(t.to_string().into())
}

/// Encode a dereferenced bound key cell into the tagged byte key the .idx
/// stores (codec encodeIndexKey): atom 0x41 + utf8, int 0x49 + big-endian i64,
/// float 0x46 + big-endian f64 bits. Mirrors Go's encodeStoreKey.
pub fn encode_store_key(v: &Value) -> Vec<u8> {
    match v {
        Value::Integer(n) => {
            let mut b = vec![0u8; 9];
            b[0] = 0x49;
            let u = *n as u64;
            let mut i = 0;
            while i < 8 {
                b[8 - i] = (u >> (i * 8)) as u8;
                i += 1;
            }
            b
        }
        Value::Float(f) => {
            let mut b = vec![0u8; 9];
            b[0] = 0x46;
            let u = f.to_bits();
            let mut i = 0;
            while i < 8 {
                b[8 - i] = (u >> (i * 8)) as u8;
                i += 1;
            }
            b
        }
        Value::Atom(s) => {
            let mut b = vec![0x41u8];
            b.extend_from_slice(s.as_bytes());
            b
        }
        _ => vec![0x3fu8],
    }
}

struct OpenStore {
    data: File,
    idx: File,
    data_size: u64,
    n_keys: u32,
    keyblob_off: u32,
    hits_off: u32,
    n_records: u32,
}

/// An opened lmdb(Dir) environment (D108): the shared Environment handle plus
/// the one (default, unnamed) Database `uw_fact_lmdb.js` writes every row
/// into. Opened RDONLY -- this store is never modified at runtime, matching
/// indexed(Prefix)'s read-only file access.
#[cfg(feature = "store_lmdb")]
struct OpenLmdbStore {
    env: Arc<lmdb_z::Environment>,
    db: Arc<lmdb_z::Database<'static>>,
}

/// A store-backed P/2 fact source over one D43 indexed(Prefix) seek store, or
/// an opt-in lmdb(Dir) tier that fails loudly (no reader built in). The files
/// open lazily on first use — after reset_fact_io() in the scale probe — so the
/// UWIX/UWFI header reads are counted in the D43 proof exactly as the Go lane
/// counts them.
pub struct SeekFactSource {
    kind: String,
    path: String,
    inner: Mutex<Option<OpenStore>>,
    /// L1 decoded-row cache (`store_cache` feature, default ON): keyed by the
    /// tagged lookup key (`encode_store_key` output), the value is the exact
    /// `Vec<(Value, Value)>` a fresh bound-key seek over `rows()` would
    /// produce, verbatim and in seek order. The store is read-only for the
    /// life of a resolve (facts never change; the store path is baked in at
    /// build time), so a given key always yields the same rows -- a cache hit
    /// is byte-safe by construction. Only the bound-key path reads/writes
    /// this map; `scan_all` (the unbound-arg1 full scan) never touches it.
    ///
    /// Interior mutability: `rows()` takes `&self`. A `RefCell` would suffice
    /// for a strictly single-threaded resolve, but it is not safe here: the
    /// T7 parallel-aggregate runtime (`par_aggregate.rs`, plain `std::thread`
    /// + `thread::scope`, NOT gated behind the `parallel` Cargo feature)
    /// clones the whole `WamState` per worker thread, and `WamState` derives
    /// `Clone`, so each worker's `seek_fact_sources: HashMap<String,
    /// Arc<SeekFactSource>>` holds a cloned `Arc` pointing at this SAME
    /// `SeekFactSource`. Concurrent `rows()` calls across worker threads are
    /// therefore a real possibility, not a hypothetical one, so this uses
    /// `Mutex` (matching `inner` above) rather than `RefCell`.
    #[cfg(feature = "store_cache")]
    cache: Mutex<HashMap<Vec<u8>, Vec<(Value, Value)>>>,
    /// Lazily-opened lmdb(Dir) environment (D108, `store_lmdb` feature only).
    /// Unused (always `None`) for an indexed(Prefix) source.
    #[cfg(feature = "store_lmdb")]
    inner_lmdb: Mutex<Option<OpenLmdbStore>>,
}

impl SeekFactSource {
    pub fn new_indexed(prefix: &str) -> Self {
        SeekFactSource {
            kind: "indexed".to_string(),
            path: prefix.to_string(),
            inner: Mutex::new(None),
            #[cfg(feature = "store_cache")]
            cache: Mutex::new(HashMap::new()),
            #[cfg(feature = "store_lmdb")]
            inner_lmdb: Mutex::new(None),
        }
    }

    pub fn new_lmdb(dir: &str) -> Self {
        SeekFactSource {
            kind: "lmdb".to_string(),
            path: dir.to_string(),
            inner: Mutex::new(None),
            #[cfg(feature = "store_cache")]
            cache: Mutex::new(HashMap::new()),
            #[cfg(feature = "store_lmdb")]
            inner_lmdb: Mutex::new(None),
        }
    }

    fn ensure_open(&self) -> Result<(), String> {
        let mut guard = self.inner.lock().unwrap();
        if guard.is_some() {
            return Ok(());
        }
        let data = File::open(format!("{}.data", self.path))
            .map_err(|e| format!("seek store open failed ({}.data): {}", self.path, e))?;
        let idx = File::open(format!("{}.idx", self.path))
            .map_err(|e| format!("seek store open failed ({}.idx): {}", self.path, e))?;
        let data_size = data.metadata().map(|m| m.len()).unwrap_or(0);
        FACT_IO_DATA_SIZE.store(data_size, Ordering::Relaxed);
        let ih = fact_io_read(&idx, 24, 0);
        if ih.len() < 24 || &ih[0..4] != b"UWIX" {
            return Err(format!("seek store: bad index magic at {}.idx", self.path));
        }
        let n_keys = le_u32(&ih, 8);
        let keyblob_off = le_u32(&ih, 12);
        let hits_off = le_u32(&ih, 16);
        let n_records = le_u32(&ih, 20);
        let dh = fact_io_read(&data, 16, 0);
        if dh.len() < 16 || &dh[0..4] != b"UWFI" {
            return Err(format!("seek store: bad data magic at {}.data", self.path));
        }
        *guard = Some(OpenStore {
            data,
            idx,
            data_size,
            n_keys,
            keyblob_off,
            hits_off,
            n_records,
        });
        Ok(())
    }

    fn lookup_offsets(store: &OpenStore, target: &[u8]) -> Vec<u32> {
        let mut lo: i64 = 0;
        let mut hi: i64 = store.n_keys as i64 - 1;
        while lo <= hi {
            let mid = (lo + hi) >> 1;
            let pos = 24 + (mid as u64) * 16;
            let e = fact_io_read(&store.idx, 16, pos);
            let key_rel = le_u32(&e, 0);
            let key_len = le_u16(&e, 4);
            let n_hits = le_u16(&e, 6);
            let hits_rel = le_u32(&e, 8);
            let k = fact_io_read(&store.idx, key_len, (store.keyblob_off + key_rel) as u64);
            let c = bytes_compare(&k, target);
            if c == 0 {
                let hits = fact_io_read(&store.idx, n_hits * 4, (store.hits_off + hits_rel) as u64);
                let mut offs = Vec::with_capacity(n_hits);
                let mut i = 0;
                while i < n_hits {
                    offs.push(le_u32(&hits, i * 4));
                    i += 1;
                }
                return offs;
            }
            if c < 0 {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
        Vec::new()
    }

    /// Decode a fact record PAYLOAD (a1_len u16 LE + a2_len u16 LE + a1 bytes +
    /// a2 bytes -- codec.js's `recordPayload`, with no outer length-prefix
    /// framing) into a typed row. Shared by the indexed .data reader (which
    /// strips the .data record's own 4-byte length prefix first) and the
    /// lmdb(Dir) reader (whose LMDB values ARE exactly this payload, since
    /// LMDB tracks value length itself) -- one decode function, so the two
    /// backends can never silently diverge on how a row's bytes become a
    /// `(Value, Value)`.
    fn decode_payload(payload: &[u8]) -> Option<(Value, Value)> {
        if payload.len() < 4 {
            return None;
        }
        let a1_len = le_u16(payload, 0);
        let a2_len = le_u16(payload, 2);
        if payload.len() < 4 + a1_len + a2_len {
            return None;
        }
        let a1 = String::from_utf8_lossy(&payload[4..4 + a1_len]).into_owned();
        let a2 = String::from_utf8_lossy(&payload[4 + a1_len..4 + a1_len + a2_len]).into_owned();
        Some((parse_fact_source_value(&a1), parse_fact_source_value(&a2)))
    }

    fn read_record(data: &File, data_off: u64) -> Option<(Value, Value)> {
        let len_buf = fact_io_read(data, 4, data_off);
        if len_buf.len() < 4 {
            return None;
        }
        let payload_len = le_u32(&len_buf, 0) as usize;
        let payload = fact_io_read(data, payload_len, data_off + 4);
        Self::decode_payload(&payload)
    }

    fn scan_all(store: &OpenStore) -> Vec<(Value, Value)> {
        let mut rows = Vec::with_capacity(store.n_records as usize);
        let mut pos: u64 = 16;
        let mut i = 0u32;
        while i < store.n_records {
            if let Some(row) = Self::read_record(&store.data, pos) {
                rows.push(row);
            }
            let len_buf = fact_io_read(&store.data, 4, pos);
            pos += 4 + le_u32(&len_buf, 0) as u64;
            i += 1;
        }
        rows
    }

    /// All matching rows for the query: a bound-key seek when `key` is Some
    /// (only the records that key touches are read), else a full scan (the
    /// unbound-arg1 provides walk). An lmdb source dispatches to the D108
    /// reader when the `store_lmdb` feature is compiled in, else panics
    /// loudly (never falls back to indexed).
    pub fn rows(&self, key: Option<Vec<u8>>) -> Vec<(Value, Value)> {
        if self.kind == "lmdb" {
            #[cfg(feature = "store_lmdb")]
            {
                return self.rows_lmdb(key);
            }
            #[cfg(not(feature = "store_lmdb"))]
            {
                panic!("{}", lmdb_seek_missing_error(&self.path));
            }
        }
        if let Err(e) = self.ensure_open() {
            panic!("{}", e);
        }
        match key {
            Some(target) => {
                // L1 decoded-row cache (see the `cache` field doc): a hit
                // returns a clone of exactly the rows a fresh seek below
                // would produce, in the same order, skipping the .idx binary
                // search and the .data reads/decode entirely.
                #[cfg(feature = "store_cache")]
                {
                    if let Some(cached) = self.cache.lock().unwrap().get(&target) {
                        return cached.clone();
                    }
                }
                let guard = self.inner.lock().unwrap();
                let store = guard.as_ref().unwrap();
                FACT_IO_DATA_SIZE.store(store.data_size, Ordering::Relaxed);
                let offs = Self::lookup_offsets(store, &target);
                let mut rows = Vec::with_capacity(offs.len());
                for off in offs {
                    if let Some(row) = Self::read_record(&store.data, off as u64) {
                        rows.push(row);
                    }
                }
                drop(guard);
                #[cfg(feature = "store_cache")]
                {
                    self.cache.lock().unwrap().insert(target, rows.clone());
                }
                rows
            }
            None => {
                // scan_all is intentionally NEVER cached: its order is
                // #4272-clustered (answer-invariant but not the seek order a
                // bound-key cache entry would need to match), and it is only
                // ever run once per unbound-arg1 query, so there is nothing
                // to amortize -- caching it would only add risk.
                let guard = self.inner.lock().unwrap();
                let store = guard.as_ref().unwrap();
                FACT_IO_DATA_SIZE.store(store.data_size, Ordering::Relaxed);
                Self::scan_all(store)
            }
        }
    }

    // ---- D108: lmdb(Dir) reader (store_lmdb feature only) -----------------
    //
    // Mirrors scripts/js_wam/uw_fact_lmdb.js's key scheme exactly:
    //   a1 range key: 0x01 || u16be(key_len) || encodeIndexKey(a1) || u64be(seq)
    // (seq = the row's index in the original source JSONL, ascending). Every
    // row is written under exactly one such key (`putAll`'s `a1RangeKey`), so
    // walking this keyspace visits every row exactly once, whether bound or
    // unbound. The `0x00 || u64be(seq)` sibling keyspace (full-row-by-seq) is
    // never read here -- it exists for other consumers of the same store and
    // is not needed to reproduce indexed(Prefix)'s seek/scan semantics.
    //
    // Byte-identity with indexed(Prefix), proven empirically against a real
    // build_lmdb_stores.sh store (docs/reports/wam_rust_lmdb_store_backend.md):
    //   * Bound-key seek: a cursor range [a1_range_start(key), a1_range_end(key)]
    //     visits exactly the rows for that key, in seq-ascending order. Since
    //     seq is the ORIGINAL source order and indexed(Prefix)'s per-key hit
    //     list is a STABLE sort tie-broken by that same original order
    //     (uw_fact_codec.js writeIndexedStore), the two orders coincide
    //     row-for-row -- no re-sort needed for the bound-key path.
    //   * Unbound-arg1 scan: LMDB's own key order is NOT what we want here --
    //     the length-prefixed key encoding (u16be length BEFORE the key
    //     bytes) sorts primarily by key LENGTH, not by the raw key bytes
    //     `bytes_compare` (and indexed's clustering) use. So the scan walks
    //     the full a1-keyspace in whatever order LMDB gives it, then
    //     STABLE-sorts by `bytes_compare` on the extracted key bytes alone --
    //     exactly indexed(Prefix)'s own clustering rule (writeIndexedStore's
    //     stable sort by encoded a1 key, ties broken by original order).
    //     Stability is what makes this safe: within one exact key's group,
    //     the natural LMDB traversal order is ALREADY seq-ascending (only the
    //     seq suffix differs among ties), so re-sorting by key alone leaves
    //     that intra-key order untouched -- matching indexed(Prefix) bit for
    //     bit, not just answer-for-answer.

    /// The inclusive range start for a bound `encode_store_key` lookup:
    /// `0x01 || u16be(key.len()) || key || 0x00*8` (seq = 0, the minimum).
    #[cfg(feature = "store_lmdb")]
    fn a1_range_start(key: &[u8]) -> Vec<u8> {
        let mut b = Vec::with_capacity(3 + key.len() + 8);
        b.push(0x01);
        b.push((key.len() >> 8) as u8);
        b.push((key.len() & 0xff) as u8);
        b.extend_from_slice(key);
        b.extend_from_slice(&[0u8; 8]);
        b
    }

    /// The inclusive range end for the same lookup (seq = u64::MAX, the
    /// maximum) -- any real key strictly between start and end shares the
    /// exact same length + key bytes (see the module-level proof above).
    #[cfg(feature = "store_lmdb")]
    fn a1_range_end(key: &[u8]) -> Vec<u8> {
        let mut b = Self::a1_range_start(key);
        let n = b.len();
        for byte in &mut b[n - 8..] {
            *byte = 0xff;
        }
        b
    }

    /// Extract the `encode_store_key` bytes embedded in an a1-range key
    /// (strip the `0x01` tag + u16be length prefix and the trailing u64be
    /// seq), for the scan-order re-sort described above.
    #[cfg(feature = "store_lmdb")]
    fn a1_range_key_bytes(k: &[u8]) -> &[u8] {
        let key_len = ((k[1] as usize) << 8) | (k[2] as usize);
        &k[3..3 + key_len]
    }

    #[cfg(feature = "store_lmdb")]
    fn ensure_open_lmdb(&self) -> Result<(), String> {
        let mut guard = self.inner_lmdb.lock().unwrap();
        if guard.is_some() {
            return Ok(());
        }
        let env = unsafe {
            let builder = lmdb_z::EnvBuilder::new()
                .map_err(|e| format!("lmdb(Dir) env builder failed ({}): {}", self.path, e))?;
            builder
                .open(&self.path, lmdb_z::open::RDONLY | lmdb_z::open::NOTLS, 0o600)
                .map_err(|e| {
                    format!(
                        "lmdb(Dir) env open failed ({}): {} -- expected a vanilla-liblmdb \
                         environment written by build_lmdb_stores.sh (UW_LMDB_DATA_V1=1); a \
                         Symas-fork lmdb-js prebuilt store is a different on-disk format \
                         (MDB_INVALID) and is not readable here.",
                        self.path, e
                    )
                })?
        };
        let env = Arc::new(env);
        let db = lmdb_z::Database::open(
            Arc::clone(&env),
            None,
            &lmdb_z::DatabaseOptions::new(lmdb_z::db::Flags::empty()),
        )
        .map_err(|e| format!("lmdb(Dir) database open failed ({}): {}", self.path, e))?;
        *guard = Some(OpenLmdbStore { env, db: Arc::new(db) });
        Ok(())
    }

    /// D108 dispatch for an lmdb(Dir) source: same cache-then-seek shape as
    /// the indexed bound-key path (a `store_cache` hit is exactly the row
    /// vector a fresh lookup would produce, by the same read-only-store
    /// argument), else a fresh bound seek or full scan per the module-level
    /// proof above.
    #[cfg(feature = "store_lmdb")]
    fn rows_lmdb(&self, key: Option<Vec<u8>>) -> Vec<(Value, Value)> {
        if let Err(e) = self.ensure_open_lmdb() {
            panic!("{}", e);
        }
        match key {
            Some(target) => {
                #[cfg(feature = "store_cache")]
                {
                    if let Some(cached) = self.cache.lock().unwrap().get(&target) {
                        return cached.clone();
                    }
                }
                let rows = self.rows_lmdb_bound(&target);
                #[cfg(feature = "store_cache")]
                {
                    self.cache.lock().unwrap().insert(target, rows.clone());
                }
                rows
            }
            None => self.rows_lmdb_scan(),
        }
    }

    #[cfg(feature = "store_lmdb")]
    fn rows_lmdb_bound(&self, target: &[u8]) -> Vec<(Value, Value)> {
        let guard = self.inner_lmdb.lock().unwrap();
        let store = guard.as_ref().unwrap();
        let start = Self::a1_range_start(target);
        let end = Self::a1_range_end(target);
        let txn = lmdb_z::ReadTransaction::new(&*store.env)
            .unwrap_or_else(|e| panic!("lmdb(Dir) read txn failed ({}): {}", self.path, e));
        let access = txn.access();
        let mut cursor = txn
            .cursor(&*store.db)
            .unwrap_or_else(|e| panic!("lmdb(Dir) cursor failed ({}): {}", self.path, e));
        let mut rows = Vec::new();
        if let Ok((k, v)) = cursor.seek_range_k::<[u8], [u8]>(&access, &start[..]) {
            if bytes_compare(k, &end) <= 0 {
                if let Some(row) = Self::decode_payload(v) {
                    rows.push(row);
                }
                while let Ok((k, v)) = cursor.next::<[u8], [u8]>(&access) {
                    if bytes_compare(k, &end) > 0 {
                        break;
                    }
                    if let Some(row) = Self::decode_payload(v) {
                        rows.push(row);
                    }
                }
            }
        }
        rows
    }

    #[cfg(feature = "store_lmdb")]
    fn rows_lmdb_scan(&self) -> Vec<(Value, Value)> {
        let guard = self.inner_lmdb.lock().unwrap();
        let store = guard.as_ref().unwrap();
        let txn = lmdb_z::ReadTransaction::new(&*store.env)
            .unwrap_or_else(|e| panic!("lmdb(Dir) read txn failed ({}): {}", self.path, e));
        let access = txn.access();
        let mut cursor = txn
            .cursor(&*store.db)
            .unwrap_or_else(|e| panic!("lmdb(Dir) cursor failed ({}): {}", self.path, e));
        // Every row lives under exactly one 0x01-tagged a1-range key, and 0x01
        // is the highest tag byte the codec ever writes (0x00 = seq keys, all
        // sorting strictly before), so walking from the first key >= [0x01]
        // to the end of the database visits every row exactly once.
        let mut entries: Vec<(Vec<u8>, Vec<u8>)> = Vec::new();
        if let Ok((k, v)) = cursor.seek_range_k::<[u8], [u8]>(&access, &[0x01u8][..]) {
            entries.push((k.to_vec(), v.to_vec()));
            while let Ok((k, v)) = cursor.next::<[u8], [u8]>(&access) {
                entries.push((k.to_vec(), v.to_vec()));
            }
        }
        // STABLE-sort by the raw encoded a1 key bytes only (see the
        // module-level proof: this reproduces indexed(Prefix)'s clustering
        // order bit for bit, including intra-key seq-ascending order).
        entries.sort_by(|a, b| {
            let ka = Self::a1_range_key_bytes(&a.0);
            let kb = Self::a1_range_key_bytes(&b.0);
            match bytes_compare(ka, kb) {
                c if c < 0 => std::cmp::Ordering::Less,
                0 => std::cmp::Ordering::Equal,
                _ => std::cmp::Ordering::Greater,
            }
        });
        entries
            .into_iter()
            .filter_map(|(_, v)| Self::decode_payload(&v))
            .collect()
    }
}

pub fn lmdb_seek_missing_error(store_path: &str) -> String {
    format!(
        "Rust WAM fact source is declared as lmdb({}) but no compatible LMDB reader is built into this Rust binary (the `store_lmdb` Cargo feature is off). This backend is opt-in and non-default; the generated project only enables `store_lmdb` (and only then depends on lmdb-zero) when its rust_wam_fact_sources declare lmdb(Dir) sources. Use UW_STORE_BACKEND=indexed (the default), which reads the dependency-free UWFI/UWIX seek store. The indexed(...) store is a different format and is not used as a fallback.",
        store_path
    )
}

// D106 (store_cache): a cache hit must return the SAME rows, in the SAME
// order, as the fresh uncached seek that would have run without it, and a
// miss must populate the cache so the next lookup for that key is a hit.
// These tests build a tiny on-disk UWFI/UWIX store pair -- the exact bytes
// `ensure_open`/`lookup_offsets`/`read_record` decode -- under a fresh
// temp-dir prefix, and drive `SeekFactSource::rows` directly, so the real
// seek path is exercised end to end, not a mock. They pass under BOTH the
// `store_cache` build (miss-then-hit) and the OFF baseline (every call is an
// uncached seek, trivially self-consistent), matching the trail_enum_tests /
// deref_memo_tests pattern of one test file proving both configs correct.
#[cfg(test)]
mod store_cache_tests {
    use super::*;
    use std::sync::atomic::AtomicU64;

    static TEST_ID: AtomicU64 = AtomicU64::new(0);

    /// Write a minimal UWFI/UWIX store pair under a fresh temp-dir prefix:
    /// two rows under key "alice" -- ("alice","bob") then ("alice","carol"),
    /// in that seek order -- plus an unrelated "zed" key so the `.idx` binary
    /// search has more than one entry to walk. Returns (temp_dir, path_prefix)
    /// so the caller can pass `&prefix` to `SeekFactSource::new_indexed` and
    /// clean up `temp_dir` afterward.
    pub(super) fn build_test_store() -> (std::path::PathBuf, String) {
        let id = TEST_ID.fetch_add(1, Ordering::Relaxed);
        let dir = std::env::temp_dir()
            .join(format!("uw_seek_cache_test_{}_{}", std::process::id(), id));
        std::fs::create_dir_all(&dir).unwrap();
        let prefix = dir.join("store").to_string_lossy().into_owned();

        // --- .data (UWFI): 16-byte header + 3 length-prefixed records, each
        // payload = a1_len(u16) + a2_len(u16) + a1 bytes + a2 bytes. ---
        fn record(a1: &str, a2: &str) -> Vec<u8> {
            let mut payload = Vec::new();
            payload.extend_from_slice(&(a1.len() as u16).to_le_bytes());
            payload.extend_from_slice(&(a2.len() as u16).to_le_bytes());
            payload.extend_from_slice(a1.as_bytes());
            payload.extend_from_slice(a2.as_bytes());
            let mut rec = Vec::new();
            rec.extend_from_slice(&(payload.len() as u32).to_le_bytes());
            rec.extend_from_slice(&payload);
            rec
        }
        let rec0 = record("alice", "bob");
        let rec1 = record("alice", "carol");
        let rec2 = record("zed", "x");
        let off0: u32 = 16;
        let off1: u32 = off0 + rec0.len() as u32;
        let off2: u32 = off1 + rec1.len() as u32;

        let mut data = Vec::new();
        data.extend_from_slice(b"UWFI");
        data.extend_from_slice(&[0u8; 12]); // reserved, unread past the magic
        data.extend_from_slice(&rec0);
        data.extend_from_slice(&rec1);
        data.extend_from_slice(&rec2);
        std::fs::write(format!("{}.data", prefix), &data).unwrap();

        // --- .idx (UWIX): 24-byte header + 2 sorted 16-byte key entries +
        // keyblob + hits blob (a u32-offset array per key, in seek order). ---
        let key_alice = encode_store_key(&Value::atom("alice"));
        let key_zed = encode_store_key(&Value::atom("zed"));
        assert!(bytes_compare(&key_alice, &key_zed) < 0, "fixture must be key-sorted for the binary search");

        let mut keyblob = Vec::new();
        let alice_rel = keyblob.len() as u32;
        keyblob.extend_from_slice(&key_alice);
        let zed_rel = keyblob.len() as u32;
        keyblob.extend_from_slice(&key_zed);

        let mut hits = Vec::new();
        let alice_hits_rel = hits.len() as u32;
        hits.extend_from_slice(&off0.to_le_bytes());
        hits.extend_from_slice(&off1.to_le_bytes());
        let zed_hits_rel = hits.len() as u32;
        hits.extend_from_slice(&off2.to_le_bytes());

        let n_keys: u32 = 2;
        let entries_off: u32 = 24;
        let keyblob_off = entries_off + n_keys * 16;
        let hits_off = keyblob_off + keyblob.len() as u32;
        let n_records: u32 = 3;

        let entry = |key_rel: u32, key_len: u16, n_hits: u16, hits_rel: u32| -> Vec<u8> {
            let mut e = Vec::new();
            e.extend_from_slice(&key_rel.to_le_bytes());
            e.extend_from_slice(&key_len.to_le_bytes());
            e.extend_from_slice(&n_hits.to_le_bytes());
            e.extend_from_slice(&hits_rel.to_le_bytes());
            e.extend_from_slice(&[0u8; 4]); // pad entry to 16 bytes
            e
        };
        let entry_alice = entry(alice_rel, key_alice.len() as u16, 2, alice_hits_rel);
        let entry_zed = entry(zed_rel, key_zed.len() as u16, 1, zed_hits_rel);

        let mut idx = Vec::new();
        idx.extend_from_slice(b"UWIX");
        idx.extend_from_slice(&[0u8; 4]); // reserved
        idx.extend_from_slice(&n_keys.to_le_bytes());
        idx.extend_from_slice(&keyblob_off.to_le_bytes());
        idx.extend_from_slice(&hits_off.to_le_bytes());
        idx.extend_from_slice(&n_records.to_le_bytes());
        idx.extend_from_slice(&entry_alice);
        idx.extend_from_slice(&entry_zed);
        idx.extend_from_slice(&keyblob);
        idx.extend_from_slice(&hits);
        std::fs::write(format!("{}.idx", prefix), &idx).unwrap();

        (dir, prefix)
    }

    #[test]
    fn cache_hit_matches_fresh_uncached_seek_same_order() {
        let (dir, prefix) = build_test_store();
        let key = encode_store_key(&Value::atom("alice"));

        // One SeekFactSource: the first rows() call is a cache MISS (under
        // `store_cache`) -- it must do the real seek and populate the cache;
        // the second call for the SAME key must be a HIT and return an
        // identical clone, in the same order.
        let src = SeekFactSource::new_indexed(&prefix);
        let miss = src.rows(Some(key.clone()));
        let hit = src.rows(Some(key.clone()));
        assert_eq!(
            hit, miss,
            "a cache hit must return the SAME rows, in the SAME order, as the seek that populated it"
        );

        // A brand-new instance has an empty cache, so its single call is a
        // ground-truth fresh uncached seek -- it must match too.
        let fresh_src = SeekFactSource::new_indexed(&prefix);
        let fresh = fresh_src.rows(Some(key));
        assert_eq!(
            fresh, miss,
            "cached result matches an independent fresh uncached seek for the same key"
        );

        let expected = vec![
            (Value::atom("alice"), Value::atom("bob")),
            (Value::atom("alice"), Value::atom("carol")),
        ];
        assert_eq!(miss, expected, "rows decoded correctly and in seek order (bob before carol)");

        let _ = std::fs::remove_dir_all(&dir);
    }

    #[test]
    fn cache_is_per_key_and_does_not_cross_contaminate() {
        let (dir, prefix) = build_test_store();
        let src = SeekFactSource::new_indexed(&prefix);

        let alice_key = encode_store_key(&Value::atom("alice"));
        let zed_key = encode_store_key(&Value::atom("zed"));
        let missing_key = encode_store_key(&Value::atom("nope"));

        let alice_rows = src.rows(Some(alice_key.clone()));
        let zed_rows = src.rows(Some(zed_key.clone()));
        // Re-fetch (now both are cache hits, if `store_cache` is on) --
        // neither key's cached entry may leak into the other's result.
        assert_eq!(src.rows(Some(alice_key)), alice_rows);
        assert_eq!(src.rows(Some(zed_key)), zed_rows);
        assert_eq!(zed_rows, vec![(Value::atom("zed"), Value::atom("x"))]);

        // A key absent from the store yields an empty result, cached or not.
        assert_eq!(src.rows(Some(missing_key.clone())), Vec::<(Value, Value)>::new());
        assert_eq!(src.rows(Some(missing_key)), Vec::<(Value, Value)>::new());

        let _ = std::fs::remove_dir_all(&dir);
    }
}

// D108: the lmdb(Dir) reader must decode the SAME `(Value, Value)` rows, in
// the SAME order, as the indexed(Prefix) reader -- for both a bound-key seek
// and an unbound-arg1 full scan. These tests build a REAL lmdb-zero
// environment (not a mock) holding the exact same three rows, in the exact
// same source order, as `store_cache_tests::build_test_store()`'s UWFI/UWIX
// fixture above, and drive both `SeekFactSource::rows` implementations
// directly, asserting the two backends' outputs are `assert_eq!`-identical.
// Only compiled when `store_lmdb` is on (this generated project's
// rust_wam_fact_sources declared an lmdb(Dir) source; see wam_rust_target.pl).
#[cfg(all(test, feature = "store_lmdb"))]
mod lmdb_reader_tests {
    use super::*;

    static TEST_ID: AtomicU64 = AtomicU64::new(0);

    /// codec.js's `recordPayload`: a1_len u16 LE + a2_len u16 LE + a1 bytes +
    /// a2 bytes -- exactly what `decode_payload` above expects.
    fn build_payload(a1: &str, a2: &str) -> Vec<u8> {
        let mut b = Vec::new();
        b.extend_from_slice(&(a1.len() as u16).to_le_bytes());
        b.extend_from_slice(&(a2.len() as u16).to_le_bytes());
        b.extend_from_slice(a1.as_bytes());
        b.extend_from_slice(a2.as_bytes());
        b
    }

    /// Write a real lmdb(Dir) environment with the SAME three rows, in the
    /// SAME source order, as `store_cache_tests::build_test_store()`:
    /// ("alice","bob") seq0, ("alice","carol") seq1, ("zed","x") seq2. Only
    /// the 0x01 a1-range keyspace is written (codec.js's `a1RangeKey`) --
    /// exactly what `rows_lmdb_bound`/`rows_lmdb_scan` read; the sibling 0x00
    /// seq keyspace is not needed (see the module-level proof above `rows_lmdb`).
    fn build_test_lmdb_store() -> (std::path::PathBuf, String) {
        let id = TEST_ID.fetch_add(1, Ordering::Relaxed);
        let dir = std::env::temp_dir()
            .join(format!("uw_seek_lmdb_test_{}_{}", std::process::id(), id));
        std::fs::create_dir_all(&dir).unwrap();
        let path = dir.to_string_lossy().into_owned();

        let env = unsafe {
            let builder = lmdb_z::EnvBuilder::new().unwrap();
            builder.open(&path, lmdb_z::open::Flags::empty(), 0o600).unwrap()
        };
        let db = lmdb_z::Database::open(
            &env,
            None,
            &lmdb_z::DatabaseOptions::new(lmdb_z::db::Flags::empty()),
        )
        .unwrap();
        let rows: [(&str, &str); 3] = [("alice", "bob"), ("alice", "carol"), ("zed", "x")];
        let txn = lmdb_z::WriteTransaction::new(&env).unwrap();
        {
            let mut access = txn.access();
            for (seq, (a1, a2)) in rows.iter().enumerate() {
                let key_bytes = encode_store_key(&Value::atom(*a1));
                let mut a1_key = Vec::new();
                a1_key.push(0x01u8);
                a1_key.extend_from_slice(&(key_bytes.len() as u16).to_be_bytes());
                a1_key.extend_from_slice(&key_bytes);
                a1_key.extend_from_slice(&(seq as u64).to_be_bytes());
                let payload = build_payload(a1, a2);
                access
                    .put(&db, &a1_key[..], &payload[..], lmdb_z::put::Flags::empty())
                    .unwrap();
            }
        }
        txn.commit().unwrap();
        drop(db);
        drop(env);
        (dir, path)
    }

    #[test]
    fn lmdb_bound_key_matches_indexed_same_rows_same_order() {
        let (idx_dir, idx_prefix) = store_cache_tests::build_test_store();
        let (lmdb_dir, lmdb_path) = build_test_lmdb_store();

        let indexed_src = SeekFactSource::new_indexed(&idx_prefix);
        let lmdb_src = SeekFactSource::new_lmdb(&lmdb_path);

        let alice_key = encode_store_key(&Value::atom("alice"));
        let zed_key = encode_store_key(&Value::atom("zed"));
        let missing_key = encode_store_key(&Value::atom("nope"));

        assert_eq!(
            lmdb_src.rows(Some(alice_key.clone())),
            indexed_src.rows(Some(alice_key.clone())),
            "lmdb bound-key seek must return the SAME rows in the SAME order as indexed"
        );
        assert_eq!(
            lmdb_src.rows(Some(zed_key.clone())),
            indexed_src.rows(Some(zed_key))
        );
        assert_eq!(
            lmdb_src.rows(Some(missing_key.clone())),
            indexed_src.rows(Some(missing_key))
        );
        assert_eq!(
            lmdb_src.rows(Some(alice_key)),
            vec![
                (Value::atom("alice"), Value::atom("bob")),
                (Value::atom("alice"), Value::atom("carol")),
            ],
            "decoded rows match the fixture content and its source order"
        );

        let _ = std::fs::remove_dir_all(&idx_dir);
        let _ = std::fs::remove_dir_all(&lmdb_dir);
    }

    #[test]
    fn lmdb_full_scan_matches_indexed_clustered_order() {
        let (idx_dir, idx_prefix) = store_cache_tests::build_test_store();
        let (lmdb_dir, lmdb_path) = build_test_lmdb_store();

        let indexed_src = SeekFactSource::new_indexed(&idx_prefix);
        let lmdb_src = SeekFactSource::new_lmdb(&lmdb_path);

        assert_eq!(
            lmdb_src.rows(None),
            indexed_src.rows(None),
            "lmdb unbound-arg1 scan must reproduce indexed's clustered order bit for bit"
        );

        let _ = std::fs::remove_dir_all(&idx_dir);
        let _ = std::fs::remove_dir_all(&lmdb_dir);
    }
}

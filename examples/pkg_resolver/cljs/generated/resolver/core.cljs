(defn invoke-predicate [pred-key args]
  (if-let [f (get predicate-dispatch pred-key)]
    (boolean (apply f args))
    false))

(defn invoke-batch [cases]
  (mapv (fn [case]
          (invoke-predicate (:pred case) (:args case)))
        cases))


  (let [cps (vec (:choice-points state))
        idx (last (keep-indexed (fn [i cp] (when (:ite cp) i)) cps))]
    (assoc state :choice-points
           (cond
             (some? idx) (vec (take idx cps))
             (seq cps) (pop cps)
             :else cps))))


(defn atom-text [state value]
  (cond
    (atom-term? value) (deintern-atom (:intern-context state) (:id value))
    (string? value) value
    (symbol? value) (name value)
    :else nil))

(declare parse-number-text)

(defn number-text [state value]
  (cond
    (number? value) (str value)
    (string? value) (when (some? (parse-number-text value)) value)
    (atom-term? value) (let [text (atom-text state value)]
                         (when (some? (parse-number-text text)) text))
    :else nil))

(defn atom-number-text [state value]
  (or (atom-text state value)
      (number-text state value)))

(defn atom-number-value [state value]
  (cond
    (number? value) value
    :else (when-let [text (atom-text state value)]
            (parse-number-text text))))

(defn intern-text-atom [state text]
  (let [[ctx id] (intern-atom (:intern-context state) text)]
    [(assoc state :intern-context ctx) (atom-term id)]))

(defn intern-char-terms [state chars]
  (loop [s state
         remaining chars
         out []]
    (if-let [ch (first remaining)]
      (let [[next-state atom] (intern-text-atom s (str ch))]
        (recur next-state (rest remaining) (conj out atom)))
      [s out])))

(defn code-list-term [state text]
  [state (list->term (:intern-context state)
                     (map int text))])

(defn char-list-term [state text]
  (let [[next-state chars] (intern-char-terms state text)]
    [next-state (list->term (:intern-context next-state) chars)]))

(defn code-point-value [state value]
  (cond
    (integer? value) value
    (atom-term? value) (parse-number-text (deintern-atom (:intern-context state) (:id value)))
    (string? value) (parse-number-text value)
    :else nil))

(defn code-list-text [state list-value]
  (when-let [items (proper-list-items state list-value)]
    (let [codes (map #(code-point-value state %) items)]
      (when (every? #(and (integer? %) (not (neg? %)) (<= % 65535)) codes)
        (apply str (map char codes))))))

(defn char-list-text [state list-value]
  (when-let [items (proper-list-items state list-value)]
    (let [chars (map #(atom-text state %) items)]
      (when (every? #(and (string? %) (= 1 (count %))) chars)
        (apply str chars)))))

(defn parse-number-text [text]
  (try
    (if (str/includes? text ".")
      (js/parseFloat text)
      (js/parseInt text))
    (catch :default _ nil)))

(defn apply-text-conversion-solution [state pred]
  (let [left (deref-value (:bindings state)
                          (or (reg-get-raw state "A1") ::unbound))
        right (deref-value (:bindings state)
                           (or (reg-get-raw state "A2") ::unbound))
        codes? (or (= pred "atom_codes/2") (= pred "string_codes/2") (= pred "number_codes/2"))
        atom? (or (= pred "atom_codes/2") (= pred "atom_chars/2")
                  (= pred "string_codes/2") (= pred "string_chars/2"))
        value-text (if atom? (atom-text state left) (number-text state left))
        list-text (if codes? (code-list-text state right) (char-list-text state right))]
    (cond
      (and (some? value-text) (some? list-text))
      (if (= value-text list-text)
        (advance state)
        (backtrack state))

      (some? value-text)
      (let [[next-state list-term] (if codes?
                                     (code-list-term state value-text)
                                     (char-list-term state value-text))
            [ok unified-state] (unify-values next-state right list-term)]
        (if ok
          (advance unified-state)
          (backtrack state)))

      (some? list-text)
      (if atom?
        (let [[next-state atom-term] (intern-text-atom state list-text)
              [ok unified-state] (unify-values next-state left atom-term)]
          (if ok
            (advance unified-state)
            (backtrack state)))
        (if-let [number-value (parse-number-text list-text)]
          (let [[ok unified-state] (unify-values state left number-value)]
            (if ok
              (advance unified-state)
              (backtrack state)))
          (backtrack state)))

      :else
      (backtrack state))))

;; ---------------------------------------------------------------------------
;; Meta-call (maplist / predsort). Persistent-map hygiene (D61 restated):
;; the sub-run gets a FRESH :choice-points / :stack / :regs; on success we
;; take only bindings/trail/heap/intern/next-var-id. Registers and leftover
;; CPs never leak into the caller.
;; ---------------------------------------------------------------------------

(defn put-arg-regs [state args]
  (loop [s state
         i 1
         remaining args]
    (if (empty? remaining)
      s
      (recur (reg-set-raw s (str "A" i) (first remaining))
             (inc i)
             (rest remaining)))))

(defn goal-name-args [state goal]
  (let [g (deref-value (:bindings state) goal)]
    (cond
      (atom-term? g)
      [(atom-text state g) []]

      (structure-term? g)
      (let [key (functor-key (:intern-context state) (:functor g))
            name (functor-name-from-key key)]
        (if (and (= name ":") (= 2 (count (:args g))))
          (goal-name-args state (second (:args g)))
          [name (vec (:args g))]))

      :else nil)))

(defn pred-extra-goal [state pred extra]
  (let [p (deref-value (:bindings state) pred)]
    (cond
      (atom-term? p)
      (let [name (atom-text state p)
            n (count extra)
            [ctx id] (intern-atom (:intern-context state) (str name "/" n))]
        [(assoc state :intern-context ctx)
         (structure-term (atom-term id) (vec extra))])

      (structure-term? p)
      (let [old (vec (:args p))
            all (into old extra)
            old-key (functor-key (:intern-context state) (:functor p))
            old-name (functor-name-from-key old-key)
            [ctx id] (intern-atom (:intern-context state) (str old-name "/" (count all)))]
        [(assoc state :intern-context ctx)
         (structure-term (atom-term id) all)])

      :else nil)))

(defn invoke-at-pc-isolated [state pc args]
  ;; Fresh env/unify/call/CP stacks: Y-slots live on :env-stack, and a
  ;; dirty unify-queue from the caller would make get-structure fail.
  ;; Bindings/trail/heap are shared so maplist producers can write out-vars.
  (let [isolated (-> state
                     (assoc :regs {}
                            :pc pc
                            :stack []
                            :env-stack []
                            :unify-queue []
                            :unify-stack []
                            :build-stack []
                            :choice-points []
                            :cut-bar 0
                            :cut-bars {}
                            :status :running)
                     (put-arg-regs args))
        result (run-wam-state isolated)]
    (when result
      (-> state
          (assoc :bindings (:bindings result)
                 :trail (:trail result)
                 :heap (:heap result)
                 :intern-context (:intern-context result)
                 :next-var-id (:next-var-id result)
                 :instr-count (:instr-count result))))))

(defn invoke-callable-isolated [state name args]
  (let [key (str name "/" (count args))]
    (if-let [pc (get (:labels state) key)]
      (invoke-at-pc-isolated state pc args)
      nil)))

(defn invoke-goal-once [state goal]
  (when-let [[name args] (goal-name-args state goal)]
    (case name
      "true" state
      ("fail" "false") nil
      (invoke-callable-isolated state name args))))

(defn maplist-collect-lists [state n-lists]
  (loop [i 0
         lists []
         unbound-at -1]
    (if (>= i n-lists)
      [lists unbound-at]
      (let [items (proper-list-items state (or (reg-get-raw state (str "A" (+ 2 i))) ::unbound))]
        (if (nil? items)
          (if (>= unbound-at 0)
            nil
            (recur (inc i) (conj lists nil) i))
          (recur (inc i) (conj lists items) unbound-at))))))

(defn maplist-call-row [state pred extras]
  (let [built (pred-extra-goal state pred extras)]
    (when built
      (let [[s2 goal] built]
        (invoke-goal-once s2 goal)))))

(defn apply-maplist-solution [state n-lists]
  (let [pred (deref-value (:bindings state)
                          (or (reg-get-raw state "A1") ::unbound))
        collected (maplist-collect-lists state n-lists)]
    (if-not collected
      (backtrack state)
      (let [[lists unbound-at] collected]
        (if (neg? unbound-at)
          (let [len0 (count (nth lists 0))]
            (if (some #(not= (count %) len0) lists)
              (backtrack state)
              (loop [s state k 0]
                (if (>= k len0)
                  (advance s)
                  (if-let [s3 (maplist-call-row s pred (mapv #(nth % k) lists))]
                    (recur s3 (inc k))
                    (backtrack state))))))
          (let [bound (nth lists (if (zero? unbound-at) 1 0) nil)]
            (if (or (nil? bound) (not= n-lists 2))
              (backtrack state)
              (loop [s state k 0 out []]
                (if (>= k (count bound))
                  (let [out-term (list->term (:intern-context s) out)
                        dest (or (reg-get-raw s (str "A" (+ 2 unbound-at))) ::unbound)
                        [ok unified] (unify-values s dest out-term)]
                    (if ok (advance unified) (backtrack state)))
                  (let [[y s1] (fresh-var s)
                        extra (if (zero? unbound-at) [y (nth bound k)] [(nth bound k) y])]
                    (if-let [s3 (maplist-call-row s1 pred extra)]
                      (recur s3 (inc k) (conj out y))
                      (backtrack state))))))))))))

(defn pred-name-text [state pred]
  (let [p (deref-value (:bindings state) pred)]
    (cond
      (atom-term? p) (functor-name-from-key (or (atom-text state p) ""))
      (string? p) (functor-name-from-key p)
      (structure-term? p)
      (functor-name-from-key (or (functor-key (:intern-context state) (:functor p)) ""))
      :else nil)))

(defn pred-less? [state pred-name x y]
  (if (= pred-name "compare")
    [state (neg? (term-compare state x y))]
    (let [[order s1] (fresh-var state)
          built (pred-extra-goal s1
                                 (or (reg-get-raw state "A1") ::unbound)
                                 [order x y])]
      (if-not built
        [state false]
        (let [[s2 goal] built
              s3 (invoke-goal-once s2 goal)]
          (if-not s3
            [state false]
            (let [o (deref-value (:bindings s3) order)]
              [s3 (= "<" (atom-text s3 o))])))))))

(defn insert-sorted-pred [state pred-name acc x]
  (loop [s state
         before []
         after acc]
    (if (empty? after)
      [s (conj before x)]
      (let [y (first after)
            [s2 less?] (pred-less? s pred-name x y)]
        (if less?
          [s2 (into (conj before x) after)]
          (recur s2 (conj before y) (rest after)))))))

(defn apply-predsort-solution [state]
  (let [pred (deref-value (:bindings state)
                          (or (reg-get-raw state "A1") ::unbound))
        items (proper-list-items state (or (reg-get-raw state "A2") ::unbound))
        out (or (reg-get-raw state "A3") ::unbound)]
    (if-not items
      (backtrack state)
      (let [pred-name (pred-name-text state pred)]
        (loop [s state
               acc []
               remaining items]
          (if (empty? remaining)
            (let [sorted-term (list->term (:intern-context s) acc)
                  [ok unified] (unify-values s out sorted-term)]
              (if ok (advance unified) (backtrack state)))
            (let [[s2 inserted] (insert-sorted-pred s pred-name acc (first remaining))]
              (recur s2 inserted (rest remaining)))))))))

(defn unify-text-atom-value [state value text]
  (if (or (string? value) (symbol? value))
    [(= (str value) text) state]
    (let [[next-state out-term] (intern-text-atom state text)]
      (unify-values next-state value out-term))))

(defn apply-atom-string-solution [state pred]
  (let [atom-reg (if (= pred "string_to_atom/2") "A2" "A1")
        string-reg (if (= pred "string_to_atom/2") "A1" "A2")
        atom-value (deref-value (:bindings state)
                                (or (reg-get-raw state atom-reg) ::unbound))
        string-value (deref-value (:bindings state)
                                  (or (reg-get-raw state string-reg) ::unbound))
        atom-text-value (atom-text state atom-value)
        string-text-value (atom-text state string-value)]
    (cond
      (some? atom-text-value)
      (let [[ok unified-state] (unify-text-atom-value state string-value atom-text-value)]
        (if ok
          (advance unified-state)
          (backtrack state)))

      (some? string-text-value)
      (let [[ok unified-state] (unify-text-atom-value state atom-value string-text-value)]
        (if ok
          (advance unified-state)
          (backtrack state)))

      :else
      (backtrack state))))

(defn apply-atom-number-solution [state]
  (let [atom-value (deref-value (:bindings state)
                                (or (reg-get-raw state "A1") ::unbound))
        number-value (deref-value (:bindings state)
                                  (or (reg-get-raw state "A2") ::unbound))
        atom-text-value (atom-number-text state atom-value)
        parsed-number-value (atom-number-value state number-value)]
    (cond
      (some? atom-text-value)
      (if-let [parsed-number (parse-number-text atom-text-value)]
        (let [[ok unified-state] (unify-values state number-value parsed-number)]
          (if ok
            (advance unified-state)
            (backtrack state)))
        (backtrack state))

      (some? parsed-number-value)
      (let [[ok unified-state] (unify-text-atom-value state atom-value (str parsed-number-value))]
        (if ok
          (advance unified-state)
          (backtrack state)))

      :else
      (backtrack state))))

(defn apply-atom-case-solution [state pred]
  (let [source (deref-value (:bindings state)
                            (or (reg-get-raw state "A1") ::unbound))
        out (deref-value (:bindings state)
                         (or (reg-get-raw state "A2") ::unbound))
        source-text (atom-text state source)]
    (if (some? source-text)
      (let [converted (if (= pred "upcase_atom/2")
                        (str/upper-case source-text)
                        (str/lower-case source-text))
            [ok unified-state] (unify-text-atom-value state out converted)]
        (if ok
          (advance unified-state)
          (backtrack state)))
      (backtrack state))))

(defn atomic-concat-text [state value]
  (or (atom-text state value)
      (number-text state value)))

(defn atomic-concat-list-term [state texts]
  (loop [s state
         remaining texts
         out []]
    (if-let [text (first remaining)]
      (let [[next-state atom] (intern-text-atom s text)]
        (recur next-state (rest remaining) (conj out atom)))
      [s (list->term (:intern-context s) out)])))

(defn apply-atomic-list-concat-solution [state pred]
  (let [list-value (deref-value (:bindings state)
                                (or (reg-get-raw state "A1") ::unbound))
        separator-value (when (= pred "atomic_list_concat/3")
                          (deref-value (:bindings state)
                                       (or (reg-get-raw state "A2") ::unbound)))
        out (deref-value (:bindings state)
                         (or (reg-get-raw state (if (= pred "atomic_list_concat/3") "A3" "A2")) ::unbound))
        items (proper-list-items state list-value)
        separator-text (if (= pred "atomic_list_concat/3")
                         (atomic-concat-text state separator-value)
                         "")
        out-text (atomic-concat-text state out)]
    (cond
      (and (some? items) (some? separator-text))
      (let [texts (map #(atomic-concat-text state %) items)]
        (if (every? some? texts)
          (let [joined (str/join separator-text texts)
                [ok unified-state] (unify-text-atom-value state out joined)]
            (if ok
              (advance unified-state)
              (backtrack state)))
          (backtrack state)))

      (and (= pred "atomic_list_concat/3")
           (or (= list-value ::unbound) (logic-var? list-value))
           (some? separator-text)
           (not= "" separator-text)
           (some? out-text))
      (let [segments (str/split out-text
                                (re-pattern (str/replace separator-text #"[.*+?^${}()|\[\]\\]" (fn [m] (str "\\" m))))
                                -1)
            [next-state list-term] (atomic-concat-list-term state segments)
            [ok unified-state] (unify-values next-state list-value list-term)]
        (if ok
          (advance unified-state)
          (backtrack state)))

      :else
      (backtrack state))))

(defn split-string-parts [source separators pad-chars]
  (let [sep-set (set separators)
        pad-set (set pad-chars)
        trim-pad (fn [part]
                   (let [chars (vec part)
                         size (count chars)
                         start (loop [idx 0]
                                 (if (and (< idx size) (contains? pad-set (chars idx)))
                                   (recur (inc idx))
                                   idx))
                         end (loop [idx size]
                               (if (and (> idx start) (contains? pad-set (chars (dec idx))))
                                 (recur (dec idx))
                                 idx))]
                     (apply str (subvec chars start end))))]
    (loop [remaining (seq source)
           current []
           out []]
      (if-let [ch (first remaining)]
        (if (contains? sep-set ch)
          (recur (next remaining) [] (conj out (trim-pad (apply str current))))
          (recur (next remaining) (conj current ch) out))
        (conj out (trim-pad (apply str current)))))))

(defn apply-split-string-solution [state]
  (let [source-value (deref-value (:bindings state)
                                  (or (reg-get-raw state "A1") ::unbound))
        separators-value (deref-value (:bindings state)
                                      (or (reg-get-raw state "A2") ::unbound))
        pad-value (deref-value (:bindings state)
                               (or (reg-get-raw state "A3") ::unbound))
        out (deref-value (:bindings state)
                         (or (reg-get-raw state "A4") ::unbound))
        source-text (atom-number-text state source-value)
        separators-text (atom-number-text state separators-value)
        pad-text (atom-number-text state pad-value)]
    (if (and (some? source-text) (some? separators-text) (some? pad-text))
      (let [parts (split-string-parts source-text separators-text pad-text)
            [next-state parts-term] (atomic-concat-list-term state parts)
            [ok unified-state] (unify-values next-state out parts-term)]
        (if ok
          (advance unified-state)
          (backtrack state)))
      (backtrack state))))

(defn char-code-text [state value]
  (let [text (atom-text state value)]
    (when (and (string? text) (= 1 (count text)))
      text)))

(defn valid-char-code? [value]
  (and (integer? value) (not (neg? value)) (<= value 65535)))

(defn char-code-count-term [state code]
  code)

(defn apply-char-code-solution [state]
  (let [char-value (deref-value (:bindings state)
                                (or (reg-get-raw state "A1") ::unbound))
        code-value (deref-value (:bindings state)
                                (or (reg-get-raw state "A2") ::unbound))
        char-text (char-code-text state char-value)
        code (code-point-value state code-value)]
    (cond
      (some? char-text)
      (let [char-code (int (first char-text))
            [ok unified-state] (if (logic-var? code-value)
                                 (unify-values state code-value (char-code-count-term state char-code))
                                 [(= code char-code) state])]
        (if ok
          (advance unified-state)
          (backtrack state)))

      (valid-char-code? code)
      (let [[next-state atom-term] (intern-text-atom state (str (char code)))
            [ok unified-state] (unify-values next-state char-value atom-term)]
        (if ok
          (advance unified-state)
          (backtrack state)))

      :else
      (backtrack state))))

(defn apply-string-code-solution [state]
  (let [index-value (deref-value (:bindings state)
                                 (or (reg-get-raw state "A1") ::unbound))
        string-value (deref-value (:bindings state)
                                  (or (reg-get-raw state "A2") ::unbound))
        code-value (deref-value (:bindings state)
                                (or (reg-get-raw state "A3") ::unbound))
        index (code-point-value state index-value)
        text (atom-text state string-value)
        code (code-point-value state code-value)]
    (if (and (integer? index)
             (pos? index)
             (string? text)
             (<= index (count text)))
      (let [actual-code (int (nth text (dec index)))
            [ok unified-state] (if (logic-var? code-value)
                                 (unify-values state code-value (char-code-count-term state actual-code))
                                 [(= code actual-code) state])]
        (if ok
          (advance unified-state)
          (backtrack state)))
      (backtrack state))))

(defn char-type-class? [ch class-name]
  ;; Portable char classification (JVM + ClojureScript): regex on (str ch)
  ;; instead of JVM-only Character/* statics.
  (let [s (str ch)]
    (case class-name
      "alpha" (boolean (re-find #"[A-Za-z]" s))
      "alnum" (boolean (re-find #"[A-Za-z0-9]" s))
      "digit" (boolean (re-find #"[0-9]" s))
      "upper" (boolean (re-find #"[A-Z]" s))
      "lower" (boolean (re-find #"[a-z]" s))
      "whitespace" (boolean (re-find #"\s" s))
      "space" (boolean (re-find #"\s" s))
      "ascii" (boolean (re-find #"[\x00-\x7f]" s))
      "punct" (boolean (re-find #"[!-/:-@\[-`{-~]" s))
      false)))

(defn char-type-code-arg [state type-value]
  (when (and (structure-term? type-value)
             (= "code/1" (functor-key (:intern-context state) (:functor type-value)))
             (= 1 (count (:args type-value))))
    (first (:args type-value))))

(defn apply-char-type-solution [state]
  (let [char-value (deref-value (:bindings state)
                                (or (reg-get-raw state "A1") ::unbound))
        type-value (deref-value (:bindings state)
                                (or (reg-get-raw state "A2") ::unbound))
        char-text (char-code-text state char-value)
        type-text (atom-text state type-value)
        code-arg (char-type-code-arg state type-value)]
    (cond
      (and (some? char-text)
           (some? type-text)
           (char-type-class? (first char-text) type-text))
      (advance state)

      (some? code-arg)
      (let [code-value (deref-value (:bindings state) code-arg)
            code (code-point-value state code-value)]
        (cond
          (some? char-text)
          (let [char-code (int (first char-text))
                [ok unified-state] (if (logic-var? code-value)
                                     (unify-values state code-value (char-code-count-term state char-code))
                                     [(= code char-code) state])]
            (if ok
              (advance unified-state)
              (backtrack state)))

          (valid-char-code? code)
          (let [[next-state atom-term] (intern-text-atom state (str (char code)))
                [ok unified-state] (unify-values next-state char-value atom-term)]
            (if ok
              (advance unified-state)
              (backtrack state)))

          :else
          (backtrack state)))

      :else
      (backtrack state))))

(defn apply-atom-concat-solution [state]
  (let [left (deref-value (:bindings state)
                          (or (reg-get-raw state "A1") ::unbound))
        right (deref-value (:bindings state)
                           (or (reg-get-raw state "A2") ::unbound))
        out (deref-value (:bindings state)
                         (or (reg-get-raw state "A3") ::unbound))
        left-text (atom-text state left)
        right-text (atom-text state right)
        out-text (atom-text state out)]
    (cond
      (and (some? left-text) (some? right-text))
      (let [[next-state atom] (intern-text-atom state (str left-text right-text))
            [ok unified-state] (unify-values next-state out atom)]
        (if ok
          (advance unified-state)
          (backtrack state)))

      (and (nil? left-text) (some? right-text) (some? out-text)
           (str/ends-with? out-text right-text))
      (let [prefix (subs out-text 0 (- (count out-text) (count right-text)))
            [ok unified-state] (unify-text-atom-value state left prefix)]
        (if ok
          (advance unified-state)
          (backtrack state)))

      (and (some? left-text) (nil? right-text) (some? out-text)
           (str/starts-with? out-text left-text))
      (let [suffix (subs out-text (count left-text))
            [ok unified-state] (unify-text-atom-value state right suffix)]
        (if ok
          (advance unified-state)
          (backtrack state)))

      :else
      (backtrack state))))

(defn apply-atom-length-solution [state]
  (let [value (deref-value (:bindings state)
                           (or (reg-get-raw state "A1") ::unbound))
        out (deref-value (:bindings state)
                         (or (reg-get-raw state "A2") ::unbound))
        text (atom-text state value)
        out-count (cond
                    (integer? out) out
                    (string? out) (parse-number-text out)
                    (atom-term? out) (parse-number-text (atom-text state out))
                    :else nil)]
    (cond
      (some? text)
      (let [len (count text)
            [ok next-state] (if (logic-var? out)
                              (unify-values state out len)
                              [(= out-count len) state])]
        (if ok
          (advance next-state)
          (backtrack state)))

      (and (logic-var? value) (= out-count 0))
      (let [[ok next-state] (unify-text-atom-value state value "")]
        (if ok
          (advance next-state)
          (backtrack state)))

      :else
      (backtrack state))))

(declare apply-first-foreign-solution)

(defn sub-atom-int-value [state value]
  (cond
    (integer? value) value
    (atom-term? value) (parse-number-text (atom-text state value))
    (string? value) (parse-number-text value)
    :else nil))

(defn sub-atom-count-term [state n]
  n)

(defn sub-atom-solution-results [state text before length after sub]
  (let [n (count text)
        before-spec (if-let [n* (sub-atom-int-value state before)]
                      (when (and (integer? n*) (not (neg? n*)) (<= n* n)) n*)
                      (when (or (= before ::unbound) (logic-var? before)) ::var))
        length-spec (if-let [n* (sub-atom-int-value state length)]
                      (when (and (integer? n*) (not (neg? n*)) (<= n* n)) n*)
                      (when (or (= length ::unbound) (logic-var? length)) ::var))
        after-spec (if-let [n* (sub-atom-int-value state after)]
                     (when (and (integer? n*) (not (neg? n*)) (<= n* n)) n*)
                     (when (or (= after ::unbound) (logic-var? after)) ::var))
        sub-text (cond
                   (or (= sub ::unbound) (logic-var? sub)) ::var
                   :else (atom-number-text state sub))]
    (when (and (some? before-spec)
               (some? length-spec)
               (some? after-spec)
               (some? sub-text))
      (let [before-range (if (= before-spec ::var) (range (inc n)) [before-spec])]
        (vec
         (for [b before-range
               l (if (= length-spec ::var) (range (inc (- n b))) [length-spec])
               :when (<= (+ b l) n)
               :let [a (- n b l)
                     piece (subs text b (+ b l))
                     bindings (cond-> {}
                                (= before-spec ::var) (assoc 2 (sub-atom-count-term state b))
                                (= length-spec ::var) (assoc 3 (sub-atom-count-term state l))
                                (= after-spec ::var) (assoc 4 (sub-atom-count-term state a))
                                (= sub-text ::var) (assoc 5 piece))]
               :when (and (or (= after-spec ::var) (= after-spec a))
                          (or (= sub-text ::var) (= sub-text piece)))]
           {:bindings bindings}))))))

(defn sub-atom-source-results [state source before length after sub]
  (let [before-n (sub-atom-int-value state before)
        length-n (sub-atom-int-value state length)
        after-n (sub-atom-int-value state after)
        sub-text (atom-number-text state sub)]
    (when (and (logic-var? source)
               (= before-n 0)
               (= after-n 0)
               (some? sub-text)
               (or (nil? length-n) (= length-n (count sub-text)))
               (or (logic-var? length) (= length ::unbound) (some? length-n)))
      [(cond-> {:bindings {1 sub-text}}
         (or (logic-var? length) (= length ::unbound))
         (assoc-in [:bindings 3] (sub-atom-count-term state (count sub-text))))])))

(defn apply-sub-atom-solution [base-state resume-pc]
  (let [source (deref-value (:bindings base-state)
                            (or (reg-get-raw base-state "A1") ::unbound))
        before (deref-value (:bindings base-state)
                            (or (reg-get-raw base-state "A2") ::unbound))
        length (deref-value (:bindings base-state)
                            (or (reg-get-raw base-state "A3") ::unbound))
        after (deref-value (:bindings base-state)
                           (or (reg-get-raw base-state "A4") ::unbound))
        sub (deref-value (:bindings base-state)
                         (or (reg-get-raw base-state "A5") ::unbound))
        text (atom-number-text base-state source)]
    (if-let [results (or (and (some? text)
                              (sub-atom-solution-results base-state text before length after sub))
                         (sub-atom-source-results base-state source before length after sub))]
      (apply-first-foreign-solution base-state resume-pc results)
      (backtrack base-state))))

(defn ground-term? [state value]
  (let [bindings (:bindings state)]
    (letfn [(ground* [term seen]
              (let [cur (deref-value bindings term)]
                (cond
                  (or (= cur ::unbound) (logic-var? cur)) false
                  (contains? seen cur) true
                  (structure-term? cur)
                  (every? #(ground* % (conj seen cur)) (:args cur))
                  :else true)))]
      (ground* value #{}))))

;; Normalising a term walks it, and a Prolog list of N elements is N NESTED
;; [|]/2 cells: recursing into the last argument costs one JS stack frame per
;; element. A 5000-package catalog term overflowed the stack before the query
;; could even start. The last argument -- the list TAIL, and the deep direction
;; of every right-nested term -- is therefore walked ITERATIVELY, with the
;; enclosing cells parked on a frame vector and rebuilt on the way back out.
;; Only the leading arguments recurse, and those are shallow (`package/2`,
;; `v/3`).
(defn- normalize-rebuild [ctx value frames]
  (loop [v value i (dec (count frames))]
    (if (neg? i)
      [ctx v]
      (let [f (nth frames i)]
        (recur (assoc (:term f) :functor (:functor f) :args (conj (:init f) v))
               (dec i))))))

(defn normalize-term* [ctx term]
  (loop [ctx ctx t term frames []]
    (cond
      (atom-term? t) (normalize-rebuild ctx t frames)

      (string? t)
      (let [[ctx* id] (intern-atom ctx t)]
        (normalize-rebuild ctx* (atom-term id) frames))

      (structure-term? t)
      (let [functor (:functor t)
            [ctx1 functor*]
            (cond
              (atom-term? functor) [ctx functor]
              (string? functor)
              (let [[ctx* id] (intern-atom ctx functor)]
                [ctx* (atom-term id)])
              :else [ctx functor])
            args (vec (:args t))]
        (if (empty? args)
          (normalize-rebuild ctx1 (assoc t :functor functor* :args []) frames)
          (let [n (count args)
                [ctx2 init*] (normalize-terms* ctx1 (subvec args 0 (dec n)))]
            (recur ctx2 (nth args (dec n))
                   (conj frames {:term t :functor functor* :init init*})))))

      :else (normalize-rebuild ctx t frames))))

(defn normalize-terms* [ctx terms]
  (loop [current-ctx ctx
         remaining terms
         out []]
    (if-let [term (first remaining)]
      (let [[next-ctx norm] (normalize-term* current-ctx term)]
        (recur next-ctx (rest remaining) (conj out norm)))
      [current-ctx (vec out)])))

(defn denormalize-term [ctx term]
  (cond
    (atom-term? term) (deintern-atom ctx (:id term))
    (structure-term? term)
    (assoc term
           :functor (denormalize-term ctx (:functor term))
           :args (mapv #(denormalize-term ctx %) (:args term)))
    :else term))

(defn normalize-regs [ctx regs]
  (reduce-kv (fn [[current-ctx out] reg value]
               (let [[next-ctx normalized] (normalize-term* current-ctx value)]
                 [next-ctx (assoc out reg normalized)]))
             [ctx {}]
             regs))

(defn list->term [ctx items]
  (reduce (fn [tail item]
            (structure-term (list-functor-term ctx) [item tail]))
          (empty-list-term ctx)
          (reverse items)))

(defn length-count-value [state value]
  (cond
    (integer? value) value
    (string? value) (parse-number-text value)
    (atom-term? value) (parse-number-text (atom-text state value))
    :else nil))

(defn generated-list-term [state n]
  (when (and (integer? n) (not (neg? n)))
    (loop [s state
           remaining n
           items []]
      (if (zero? remaining)
        [(list->term (:intern-context s) items) s]
        (let [[fresh s*] (fresh-var s)]
          (recur s* (dec remaining) (conj items fresh)))))))

(defn apply-length-solution [state]
  (let [list-value (deref-value (:bindings state)
                                (or (reg-get-raw state "A1") ::unbound))
        out (deref-value (:bindings state)
                         (or (reg-get-raw state "A2") ::unbound))
        len (proper-list-length state list-value)
        out-count (length-count-value state out)]
    (cond
      (some? len)
      (if (logic-var? out)
        (let [[ok next-state] (unify-values state out len)]
          (if ok
            (advance next-state)
            (backtrack state)))
        (if (= out-count len)
          (advance state)
          (backtrack state)))

      (and (logic-var? list-value) (integer? out-count) (not (neg? out-count)))
      (if-let [[list-term generated-state] (generated-list-term state out-count)]
        (let [[ok next-state] (unify-values generated-state list-value list-term)]
          (if ok
            (advance next-state)
            (backtrack state)))
        (backtrack state))

      :else
      (backtrack state))))

(defn univ-decompose-term [state term]
  (let [term* (deref-value (:bindings state) term)
        ctx (:intern-context state)]
    (cond
      (structure-term? term*)
      (let [key (functor-key ctx (:functor term*))
            name (normalize-literal-atom ctx (functor-name-from-key key))]
        (list->term ctx (cons name (:args term*))))

      (or (atom-term? term*) (number? term*))
      (list->term ctx [term*])

      :else
      nil)))

(defn univ-compose-term [state list-value]
  (when-let [items (proper-list-items state list-value)]
    (when (seq items)
      (if (= 1 (count items))
        [state (deref-value (:bindings state) (first items))]
        (let [head (deref-value (:bindings state) (first items))
              args (vec (rest items))]
          (when (atom-term? head)
            (let [name (deintern-atom (:intern-context state) (:id head))
                  functor-key (str name "/" (count args))
                  [ctx* functor-id] (intern-atom (:intern-context state) functor-key)
                  state* (assoc state :intern-context ctx*)]
              [state* (structure-term (atom-term functor-id) args)])))))))

(defn apply-univ-solution [state]
  (let [raw-term (or (reg-get-raw state "A1") ::unbound)
        term (deref-value (:bindings state) raw-term)
        out (deref-value (:bindings state)
                         (or (reg-get-raw state "A2") ::unbound))]
    (if (logic-var? term)
      (if-let [[compose-state built] (univ-compose-term state out)]
        (let [[ok next-state] (unify-values compose-state raw-term built)]
          (if ok
            (advance next-state)
            (backtrack state)))
        (backtrack state))
      (if-let [list-term (univ-decompose-term state term)]
        (let [[ok next-state] (unify-values state out list-term)]
          (if ok
            (advance next-state)
            (backtrack state)))
        (backtrack state)))))

(defn term-variables [state term]
  (letfn [(add-var [acc var-value]
            (let [id (:var var-value)]
              (if (contains? (:seen acc) id)
                acc
                (-> acc
                    (update :seen conj id)
                    (update :vars conj var-value)))))
          (walk [acc value]
            (let [value* (deref-value (:bindings state) value)]
              (cond
                (logic-var? value*) (add-var acc value*)
                (structure-term? value*) (reduce walk acc (:args value*))
                :else acc)))]
    (:vars (walk {:seen #{} :vars []} term))))

(defn apply-term-variables-solution [state]
  (let [term (or (reg-get-raw state "A1") ::unbound)
        out (deref-value (:bindings state)
                         (or (reg-get-raw state "A2") ::unbound))
        vars-term (list->term (:intern-context state) (term-variables state term))
        [ok next-state] (unify-values state out vars-term)]
    (if ok
      (advance next-state)
      (backtrack state))))

(defn apply-variant-solution [state]
  (let [left (or (reg-get-raw state "A1") ::unbound)
        right (or (reg-get-raw state "A2") ::unbound)]
    (if (variant-term? state left right)
      (advance state)
      (backtrack state))))

(defn term->unify-items [term]
  (if (structure-term? term)
    (seq (:args term))
    nil))

;; Read mode is a STACK of cursors, not a single queue. `get_structure`/
;; `get_list` can fire while an enclosing structure is still being read -- the
;; clause head `direct_on([depends(N,V,D,_)|Rest], ...)` compiles to
;;   get-list A1 / unify-variable X9 / get-structure depends/4 X9 /
;;   unify-variable ...x4 / unify-variable Rest
;; where the LAST unify-variable belongs to the outer list cell and names the
;; TAIL. Overwriting the queue dropped it, leaving the tail an unbound variable:
;; the recursive call then unified it with `[]` and the walk silently stopped
;; after one element. Pushing the enclosing cursor (and popping it when the
;; inner one is exhausted) is what the JS WAM runtime's read_stack does.
(defn enter-unify-mode [state items]
  (if (seq (:unify-queue state))
    (-> state
        (update :unify-stack #(conj (or % []) (:unify-queue state)))
        (assoc :unify-queue (vec items)))
    (assoc state :unify-queue (vec items))))

;; The read-mode cursor advances once per unify_* instruction -- 1.5 million
;; times in one 5000-package resolve. `(vec (rest q))` rebuilt the remaining
;; queue each time; `subvec` shares it.
(defn pop-unify-item [state]
  (loop [s state]
    (let [q (:unify-queue s)]
      (if (seq q)
        [(nth q 0) (assoc s :unify-queue (subvec q 1))]
        (let [stk (:unify-stack s)]
          (if (seq stk)
            (recur (-> s
                       (assoc :unify-queue (vec (peek stk)))
                       (assoc :unify-stack (pop stk))))
            [nil s]))))))

(defn fresh-var [state]
  (let [id (:next-var-id state)]
    [(var-term id) (update state :next-var-id inc)]))

;; get_structure / get_list, in ONE place. The interpreter's step and the
;; lowered emitter both call these, so a read/write-mode fix cannot land in one
;; and miss the other -- which is exactly how the missing WRITE mode survived:
;; the lowered copy had only the read case, and a predicate whose OUTPUT
;; argument is a compound (`probe_wrap(X, w(X, ok))`) failed in its own head.
(defn op-get-structure [state functor reg]
  (let [reg-val (deref-value (:bindings state)
                             (or (reg-get-raw state reg) ::unbound))]
    (cond
      (structure-term? reg-val)
      (if (interned-equal? (:functor reg-val) functor)
        (-> state (enter-unify-mode (:args reg-val)) advance)
        (backtrack state))

      ;; WRITE mode: unbound register -> build the cell and read-unify against
      ;; its fresh argument variables, so the following unify-* instructions
      ;; construct rather than match.
      (or (logic-var? reg-val) (= reg-val ::unbound))
      (let [ar (or (functor-arity (:intern-context state) functor) 0)
            [s1 args] (fresh-compound-args state ar)
            cell (structure-term functor args)
            s2 (if (logic-var? reg-val)
                 (bind-var s1 reg-val cell)
                 (reg-set-raw s1 reg cell))]
        (-> s2 (enter-unify-mode args) advance))

      :else (backtrack state))))

(defn op-get-list [state reg]
  (op-get-structure state (list-functor-term (:intern-context state)) reg))

(defn copy-term-walk [state term var-map]
  (let [term* (deref-value (:bindings state) term)]
    (cond
      (logic-var? term*)
      (if-let [fresh (get var-map (:var term*))]
        [fresh state var-map]
        (let [[fresh next-state] (fresh-var state)]
          [fresh next-state (assoc var-map (:var term*) fresh)]))

      (structure-term? term*)
      (loop [s state
             env var-map
             args (:args term*)
             out []]
        (if-let [arg (first args)]
          (let [[arg-copy s* env*] (copy-term-walk s arg env)]
            (recur s* env* (next args) (conj out arg-copy)))
          [(structure-term (:functor term*) out) s env]))

      :else
      [term* state var-map])))

(defn copy-term [state term]
  (let [[copied next-state _] (copy-term-walk state term {})]
    [copied next-state]))

(defn apply-copy-term-solution [state]
  (let [source (or (reg-get-raw state "A1") ::unbound)
        target (or (reg-get-raw state "A2") ::unbound)
        [copied copy-state] (copy-term state source)
        [ok next-state] (unify-values copy-state target copied)]
    (if ok
      (advance next-state)
      (backtrack state))))

(defn push-build-frame [state target-reg functor arity]
  (update state :build-stack conj {:target-reg target-reg
                                   :functor functor
                                   :arity arity
                                   :args []}))

(defn update-top-build-frame [state f]
  (update state :build-stack
          (fn [stk]
            (conj (pop stk) (f (peek stk))))))

(defn append-build-arg [state arg]
  (update-top-build-frame state #(update % :args conj arg)))

(defn top-build-frame-complete? [state]
  (let [frame (peek (:build-stack state))]
    (and frame (= (count (:args frame)) (:arity frame)))))

(defn a-slot? [reg]
  (and (string? reg) (.startsWith reg "A")))

(defn assign-or-unify-reg [state reg term]
  (let [current (or (reg-get-raw state reg) ::unbound)]
    (cond
      (= current ::unbound)
      [true (reg-set-raw state reg term)]

      :else
      (unify-values state current term))))

(defn finalize-top-build-frame [state]
  (let [frame (peek (:build-stack state))
        built (structure-term (:functor frame) (:args frame))
        target-reg (:target-reg frame)
        next-state (update state :build-stack pop)]
    (if (a-slot? target-reg)
      (reg-set-raw next-state target-reg built)
      (let [[ok bound-state] (assign-or-unify-reg next-state target-reg built)]
        (if ok
          bound-state
          (backtrack state))))))

(defn finalize-complete-builds [state]
  (loop [s state]
    (if (top-build-frame-complete? s)
      (let [next-state (finalize-top-build-frame s)]
        (if (= :failed (:status next-state))
          next-state
          (recur next-state)))
      s)))

;; A dispatch destination is either an address (jump there, entering the clause
;; DETERMINISTICALLY -- no choice point is pushed, and none is expected) or
;; :fallthrough (run the clause chain from the next instruction, exactly as an
;; unindexed predicate does).
(defn switch-jump [state target]
  (if (integer? target)
    (assoc state :pc target)
    (advance state)))

(defn switch-reg-value [state instr]
  (deref-value (:bindings state) (reg-get-raw state (or (:reg instr) "A1"))))

(defn switch-unbound-value? [v]
  (or (nil? v) (= v ::unbound) (logic-var? v)))

;; An unbound dispatch register, and any key the index does not mention, fall
;; through to the full clause chain: indexing may only ever REMOVE work that
;; could not have produced an answer, never an alternative.
(defn switch-target [state instr]
  (let [raw (switch-reg-value state instr)]
    (if (switch-unbound-value? raw)
      (advance state)
      (let [reg-val (normalize-dispatch-value (:intern-context state) raw)
            dispatch-map (:dispatch-map instr)
            case-map (:case-map instr)
            default-target-pc (:default-target-pc instr)
            default-fallthrough? (:default-fallthrough? instr)]
        (cond
          (contains? dispatch-map reg-val)
          (switch-jump state (get dispatch-map reg-val))

          (contains? case-map reg-val)
          (assoc state :pc (get case-map reg-val))

          default-target-pc
          (assoc state :pc default-target-pc)

          default-fallthrough?
          (advance state)

          :else
          (backtrack state))))))

(defn switch-structure-target [state instr]
  (let [v (switch-reg-value state instr)]
    (if (structure-term? v)
      (let [target (get (:functor-map instr) (:functor v) ::miss)]
        (if (= target ::miss)
          (advance state)
          (switch-jump state target)))
      (advance state))))

;; switch_on_term is the type-based form: constants take the constant table,
;; a cons cell takes the dedicated list label, any other compound takes the
;; structure table. This is the one that matters for `resolver.pl` -- every
;; list-walking predicate is `p([], ...)` / `p([H|T], ...)`, and without it
;; each of the 5000 elements of a catalog list pushed a choice point, failed
;; clause 1's `get_constant []`, and backtracked into clause 2.
(defn switch-term-target [state instr]
  (let [v (switch-reg-value state instr)]
    (cond
      (structure-term? v)
      (if (interned-equal? (:functor v) (:list-functor instr))
        (switch-jump state (:list-target instr))
        (let [target (get (:struct-map instr) (:functor v) ::miss)]
          (if (= target ::miss)
            (advance state)
            (switch-jump state target))))

      (switch-unbound-value? v)
      (advance state)

      :else
      (let [key (normalize-dispatch-value (:intern-context state) v)
            target (get (:const-map instr) key ::miss)]
        (if (= target ::miss)
          (advance state)
          (switch-jump state target))))))

(defn foreign-key [pred arity]
  (str pred "/" arity))

(defn foreign-args [state arity]
  (mapv (fn [idx]
          (denormalize-term (:intern-context state)
                            (deref-value (:bindings state)
                                         (reg-get-raw state (str "A" idx)))))
        (range 1 (inc arity))))

(defn foreign-binding-reg [idx]
  (cond
    (integer? idx) (str "A" idx)
    (string? idx) idx
    (keyword? idx) (name idx)
    :else (str idx)))

(defn apply-foreign-bindings [state bindings]
  (loop [s state
         pairs (seq bindings)]
    (if-let [[idx value] (first pairs)]
      (let [[ctx* value*] (normalize-term* (:intern-context s) value)
            s* (assoc s :intern-context ctx*)
            reg (foreign-binding-reg idx)
            current (or (reg-get-raw s* reg) ::unbound)
            [ok next-state] (unify-values s* current value*)]
        (if ok
          (recur next-state (next pairs))
          [false state]))
      [true s])))

(defn apply-foreign-result [state result]
  (cond
    (true? result)
    [true state]

    (false? result)
    [false state]

    (and (map? result) (contains? result :bindings))
    (apply-foreign-bindings state (:bindings result))

    (and (vector? result) (not-empty result))
    (apply-foreign-bindings state (into {} (map-indexed (fn [idx value] [(inc idx) value]) result)))

    :else
    [false state]))

(defn foreign-solution-results [result]
  (cond
    (and (map? result) (contains? result :solutions))
    (seq (:solutions result))

    (and (map? result) (contains? result :results))
    (seq (:results result))

    :else
    nil))

(defn push-foreign-choice-point [state base-state resume-pc results]
  (if (seq results)
    (update state :choice-points conj
            (foreign-choice-snapshot base-state resume-pc results))
    state))

(defn apply-first-foreign-solution [base-state resume-pc results]
  (loop [remaining (seq results)]
    (if-let [result (first remaining)]
      (let [[ok next-state] (apply-foreign-result base-state result)]
        (if ok
          (-> next-state
              (push-foreign-choice-point base-state resume-pc (next remaining))
              (assoc :pc resume-pc))
          (recur (next remaining))))
      (backtrack base-state))))

(defn aggregate-result-choice-snapshot [state bag-reg results]
  (assoc (choice-snapshot state (:pc state))
         :kind :aggregate-result
         :aggregate-bag-reg bag-reg
         :aggregate-results (vec results)))

(defn push-aggregate-result-choice-point [state bag-reg results]
  (if (seq results)
    (update state :choice-points conj
            (aggregate-result-choice-snapshot state bag-reg results))
    state))

(defn apply-aggregate-results [state bag-reg results]
  (if-let [remaining (seq results)]
    (let [bag (first remaining)
          alternatives (next remaining)
          choice-state (push-aggregate-result-choice-point state bag-reg alternatives)
          current (or (reg-get-raw choice-state bag-reg) ::unbound)
          [ok next-state] (if (= current ::unbound)
                            [true (reg-set-raw choice-state bag-reg bag)]
                            (unify-values choice-state current bag))]
      (if ok
        next-state
        (backtrack choice-state)))
    (backtrack state)))

(defn activate-choice [state cp]
  (case (:kind cp)
    :foreign
    (if-let [results (seq (:foreign-results cp))]
      (apply-first-foreign-solution state (:pc cp) results)
      (assoc state :status :running))

    :member
    (apply-member-solution state (:pc cp) (:member-elem cp) (:member-rest cp))

    :aggregate-result
    (apply-aggregate-results state (:aggregate-bag-reg cp) (:aggregate-results cp))

    :aggregate
    (let [results (aggregate-result-terms state
                                          (:aggregate-kind cp)
                                          (:aggregate-collected cp)
                                          (:aggregate-witness-regs cp))
          resumed-state (assoc state :pc (:aggregate-next-pc cp))]
      (apply-aggregate-results resumed-state (:aggregate-bag-reg cp) results))

    (assoc state :status :running)))

(defn execute-foreign [state instr]
  (let [key (foreign-key (:pred instr) (:arity instr))
        handler (get (:foreign-handlers state) key)]
    (if handler
      (let [result (handler (foreign-args state (:arity instr)))
            resume-pc (inc (:pc state))]
        (if-let [results (foreign-solution-results result)]
          (apply-first-foreign-solution state resume-pc results)
          (let [[ok next-state] (apply-foreign-result state result)]
            (if ok
              (advance next-state)
              (backtrack state)))))
      (backtrack state))))

(defn step [state]
  (let [instr (fetch-instr state)]
    (if-not instr
      (backtrack state)
      (case (:op instr)
        :raw
        ;; switch_on_* are first-argument indexing hints; if unimplemented, fall
        ;; through to the try_me_else clause chain (correct, just unindexed).
        (if (re-find #"^switch_on_" (or (:text instr) ""))
          (advance state)
          (backtrack state))

        :get-constant
        (let [reg (:reg instr)
              constant (:constant instr)
              current (or (reg-get-raw state reg) ::unbound)
              current* (if (= current ::unbound) current
                         (deref-value (:bindings state) current))]
          (cond
            (= current* ::unbound)
            (-> state
                (reg-set-raw reg constant)
                advance)

            (logic-var? current*)
            (-> (bind-var state current* constant)
                advance)

            (interned-equal? current* constant)
            (advance state)

            :else
            (backtrack state)))

        :put-constant
        (-> state
            (reg-set-raw (:reg instr) (:constant instr))
            advance)

        :put-structure
        (let [arity (or (:arity instr)
                        (functor-arity (:intern-context state) (:functor instr)))]
          (-> state
              (push-build-frame (:reg instr) (:functor instr) arity)
              advance))

        :put-list
        (-> state
            (push-build-frame (:reg instr) (list-functor-term (:intern-context state)) 2)
            advance)

        :get-variable
        (let [val (reg-get-raw state (:reg instr))]
          (-> state
              (reg-set-raw (:var instr) val)
              advance))

        :get-value
        (let [left (or (reg-get-raw state (:var instr)) ::unbound)
              right (or (reg-get-raw state (:reg instr)) ::unbound)
              [ok next-state] (unify-values state left right)]
          (if ok
            (advance next-state)
            (backtrack state)))

        :get-structure
        (op-get-structure state (:functor instr) (:reg instr))

        :get-list
        (op-get-list state (:reg instr))

        :put-variable
        (let [[fresh next-state] (fresh-var state)]
          (-> next-state
              (reg-set-raw (:var instr) fresh)
              (reg-set-raw (:reg instr) fresh)
              advance))

        :put-value
        (let [val (deref-value (:bindings state)
                               (reg-get-raw state (:var instr)))]
          (-> state
              (reg-set-raw (:reg instr) val)
              advance))

        :set-constant
        (-> state
            (append-build-arg (:constant instr))
            finalize-complete-builds
            advance)

        :set-value
        (let [val (deref-value (:bindings state)
                               (reg-get-raw state (:var instr)))]
          (-> state
              (append-build-arg val)
              finalize-complete-builds
              advance))

        :set-variable
        (let [[fresh next-state] (fresh-var state)]
          (-> next-state
              (reg-set-raw (:var instr) fresh)
              (append-build-arg fresh)
              finalize-complete-builds
              advance))

        :unify-constant
        (let [[item next-state] (pop-unify-item state)
              [ok bound-state] (unify-values next-state item (:constant instr))]
          (if ok
            (advance bound-state)
            (backtrack state)))

        :unify-variable
        (let [[item next-state] (pop-unify-item state)]
          (-> next-state
              (reg-set-raw (:var instr) item)
              advance))

        :unify-value
        (let [[item next-state] (pop-unify-item state)
              reg-val (or (reg-get-raw next-state (:var instr)) ::unbound)
              [ok bound-state] (unify-values next-state reg-val item)]
          (if ok
            (advance bound-state)
            (backtrack state)))

        :call-pc
        (-> state
            (enter-call-barrier)
            (update :stack conj (inc (:pc state)))
            (assoc :pc (:target-pc instr)))

        :execute-pc
        (-> state
            (enter-execute-barrier)
            (assoc :pc (:target-pc instr)))

        :jump-pc
        (assoc state :pc (:target-pc instr))

        :begin-aggregate
        (if-let [end-pc (find-matching-end-aggregate (:code state) (:pc state))]
          (-> state
              (update :choice-points conj (aggregate-choice-snapshot state instr end-pc))
              advance)
          (backtrack state))

        :end-aggregate
        (if-let [collected-state (collect-aggregate-template state (:template instr))]
          (backtrack collected-state)
          (backtrack state))

        :allocate
        (-> state
            (update :env-stack conj {})
            advance)

        :deallocate
        (-> state
            (update :env-stack #(if (seq %) (pop %) %))
            advance)

        :switch-on-constant
        (switch-target state instr)

        :switch-on-structure
        (switch-structure-target state instr)

        :switch-on-term
        (switch-term-target state instr)

        ;; A dispatch chain (`try L / retry L' / trust L''`) is the group form
        ;; of try_me_else / retry_me_else / trust_me: the alternative it leaves
        ;; behind is the NEXT chain entry, and the clause body is jumped to.
        :try-pc
        (-> state
            (push-choice-point (inc (:pc state)))
            (assoc :pc (:target-pc instr)))

        :retry-pc
        (-> state
            (push-choice-point (inc (:pc state)))
            (assoc :pc (:target-pc instr)))

        :trust-pc
        (assoc state :pc (:target-pc instr))

        :try-me-else-pc
        (-> state
            (push-choice-point (:target-pc instr) (true? (:ite instr)))
            advance)

        :retry-me-else-pc
        (-> state
            (push-choice-point (:target-pc instr))
            advance)

        :trust-me
        (advance state)

        :builtin-call
        (case (:pred instr)
          "=/2"
          (let [left (or (reg-get-raw state "A1") ::unbound)
                right (or (reg-get-raw state "A2") ::unbound)
                [ok next-state] (unify-values state left right)]
            (if ok
              (advance next-state)
              (backtrack state)))

          "\\=/2"
          (let [left (or (reg-get-raw state "A1") ::unbound)
                right (or (reg-get-raw state "A2") ::unbound)]
            (if (unifiable? state left right)
              (backtrack state)
              (advance state)))

          "==/2"
          (let [left (or (reg-get-raw state "A1") ::unbound)
                right (or (reg-get-raw state "A2") ::unbound)]
            (if (term-identical? state left right)
              (advance state)
              (backtrack state)))

          "\\==/2"
          (let [left (or (reg-get-raw state "A1") ::unbound)
                right (or (reg-get-raw state "A2") ::unbound)]
            (if (term-identical? state left right)
              (backtrack state)
              (advance state)))

          "@</2"
          (let [left (or (reg-get-raw state "A1") ::unbound)
                right (or (reg-get-raw state "A2") ::unbound)]
            (if (term-less? state left right)
              (advance state)
              (backtrack state)))

          "@=</2"
          (let [left (or (reg-get-raw state "A1") ::unbound)
                right (or (reg-get-raw state "A2") ::unbound)]
            (if (term-less-or-equal? state left right)
              (advance state)
              (backtrack state)))

          "@>/2"
          (let [left (or (reg-get-raw state "A1") ::unbound)
                right (or (reg-get-raw state "A2") ::unbound)]
            (if (term-greater? state left right)
              (advance state)
              (backtrack state)))

          "@>=/2"
          (let [left (or (reg-get-raw state "A1") ::unbound)
                right (or (reg-get-raw state "A2") ::unbound)]
            (if (term-greater-or-equal? state left right)
              (advance state)
              (backtrack state)))

          "compare/3"
          (apply-compare-solution state)

          "=:=/2"
          (let [left (deref-value (:bindings state)
                                  (or (reg-get-raw state "A1") ::unbound))
                right (deref-value (:bindings state)
                                   (or (reg-get-raw state "A2") ::unbound))]
            (if (arithmetic-equal? state left right)
              (advance state)
              (backtrack state)))

          "=\\=/2"
          (let [left (deref-value (:bindings state)
                                  (or (reg-get-raw state "A1") ::unbound))
                right (deref-value (:bindings state)
                                   (or (reg-get-raw state "A2") ::unbound))]
            (if (arithmetic-not-equal? state left right)
              (advance state)
              (backtrack state)))

          "succ/2"
          (apply-succ-solution state)

          "is/2"
          (let [left (deref-value (:bindings state)
                                  (or (reg-get-raw state "A1") ::unbound))
                expr (deref-value (:bindings state)
                                  (or (reg-get-raw state "A2") ::unbound))
                result (eval-arithmetic-term state expr)]
            (if (some? result)
              (let [[ok next-state] (unify-values state left result)]
                (if ok
                  (advance next-state)
                  (backtrack state)))
              (backtrack state)))

          "</2"
          (let [left (deref-value (:bindings state)
                                  (or (reg-get-raw state "A1") ::unbound))
                right (deref-value (:bindings state)
                                   (or (reg-get-raw state "A2") ::unbound))]
            (if (arithmetic-less? state left right)
              (advance state)
              (backtrack state)))

          ">/2"
          (let [left (deref-value (:bindings state)
                                  (or (reg-get-raw state "A1") ::unbound))
                right (deref-value (:bindings state)
                                   (or (reg-get-raw state "A2") ::unbound))]
            (if (arithmetic-greater? state left right)
              (advance state)
              (backtrack state)))

          "=</2"
          (let [left (deref-value (:bindings state)
                                  (or (reg-get-raw state "A1") ::unbound))
                right (deref-value (:bindings state)
                                   (or (reg-get-raw state "A2") ::unbound))]
            (if (arithmetic-less-or-equal? state left right)
              (advance state)
              (backtrack state)))

          ">=/2"
          (let [left (deref-value (:bindings state)
                                  (or (reg-get-raw state "A1") ::unbound))
                right (deref-value (:bindings state)
                                   (or (reg-get-raw state "A2") ::unbound))]
            (if (arithmetic-greater-or-equal? state left right)
              (advance state)
              (backtrack state)))

          "true/0"
          (advance state)

          "fail/0"
          (backtrack state)

          "atom/1"
          (let [value (deref-value (:bindings state)
                                   (or (reg-get-raw state "A1") ::unbound))]
            (if (atom-term? value)
              (advance state)
              (backtrack state)))

          "integer/1"
          (let [value (deref-value (:bindings state)
                                   (or (reg-get-raw state "A1") ::unbound))]
            (if (integer? value)
              (advance state)
              (backtrack state)))

          "number/1"
          (let [value (deref-value (:bindings state)
                                   (or (reg-get-raw state "A1") ::unbound))]
            (if (number? value)
              (advance state)
              (backtrack state)))

          "atomic/1"
          (let [value (deref-value (:bindings state)
                                   (or (reg-get-raw state "A1") ::unbound))]
            (if (or (atom-term? value) (number? value))
              (advance state)
              (backtrack state)))

          "nonvar/1"
          (let [value (deref-value (:bindings state)
                                   (or (reg-get-raw state "A1") ::unbound))]
            (if (and (not= value ::unbound) (not (logic-var? value)))
              (advance state)
              (backtrack state)))

          "var/1"
          (let [value (deref-value (:bindings state)
                                   (or (reg-get-raw state "A1") ::unbound))]
            (if (or (= value ::unbound) (logic-var? value))
              (advance state)
              (backtrack state)))

          "compound/1"
          (let [value (deref-value (:bindings state)
                                   (or (reg-get-raw state "A1") ::unbound))]
            (if (structure-term? value)
              (advance state)
              (backtrack state)))

          "callable/1"
          (let [value (deref-value (:bindings state)
                                   (or (reg-get-raw state "A1") ::unbound))]
            (if (or (atom-term? value) (structure-term? value))
              (advance state)
              (backtrack state)))

          "float/1"
          (let [value (deref-value (:bindings state)
                                   (or (reg-get-raw state "A1") ::unbound))]
            (if (float? value)
              (advance state)
              (backtrack state)))

          "is_list/1"
          (let [value (deref-value (:bindings state)
                                   (or (reg-get-raw state "A1") ::unbound))]
            (if (proper-list-term? state value)
              (advance state)
              (backtrack state)))

          "length/2"
          (apply-length-solution state)

          "member/2"
          (let [elem (deref-value (:bindings state)
                                  (or (reg-get-raw state "A1") ::unbound))
                list-value (deref-value (:bindings state)
                                        (or (reg-get-raw state "A2") ::unbound))]
            (apply-member-solution state (inc (:pc state)) elem list-value))

          "memberchk/2"
          (let [elem (deref-value (:bindings state)
                                  (or (reg-get-raw state "A1") ::unbound))
                list-value (deref-value (:bindings state)
                                        (or (reg-get-raw state "A2") ::unbound))]
            (apply-memberchk-solution state elem list-value))

          "append/3"
          (let [left (deref-value (:bindings state)
                                  (or (reg-get-raw state "A1") ::unbound))
                right (deref-value (:bindings state)
                                   (or (reg-get-raw state "A2") ::unbound))
                out (deref-value (:bindings state)
                                 (or (reg-get-raw state "A3") ::unbound))]
            (apply-append-solution state (inc (:pc state)) left right out))

          "reverse/2"
          (apply-reverse-solution state)

          "last/2"
          (apply-last-solution state)

          "nth0/3"
          (apply-nth0-solution state (inc (:pc state)))

          "nth1/3"
          (apply-nth1-solution state (inc (:pc state)))

          "select/3"
          (apply-select-solution state (inc (:pc state)))

          "between/3"
          (apply-between-solution state (inc (:pc state)))

          "numlist/3"
          (apply-numlist-solution state)

          "sum_list/2"
          (apply-numeric-list-reducer-solution state "sum_list/2")

          "min_list/2"
          (apply-numeric-list-reducer-solution state "min_list/2")

          "max_list/2"
          (apply-numeric-list-reducer-solution state "max_list/2")

          "delete/3"
          (apply-delete-solution state)

          "subtract/3"
          (apply-subtract-solution state)

          "intersection/3"
          (apply-intersection-solution state)

          "union/3"
          (apply-union-solution state)

          "permutation/2"
          (apply-permutation-solution state)

          "list_to_set/2"
          (apply-list-to-set-solution state)

          "sort/2"
          (apply-sort-solution state)

          "msort/2"
          (apply-msort-solution state)

          "keysort/2"
          (apply-keysort-solution state)

          "copy_term/2"
          (apply-copy-term-solution state)

          "term_variables/2"
          (apply-term-variables-solution state)

          "variant/2"
          (apply-variant-solution state)

          "functor/3"
          (apply-functor-solution state)

          "arg/3"
          (apply-arg-solution state)

          "compound_name_arity/3"
          (apply-compound-name-arity-solution state)

          "compound_name_arguments/3"
          (apply-compound-name-arguments-solution state)

          "=../2"
          (apply-univ-solution state)

          "ground/1"
          (let [value (deref-value (:bindings state)
                                   (or (reg-get-raw state "A1") ::unbound))]
            (if (ground-term? state value)
              (advance state)
              (backtrack state)))

          "atom_codes/2"
          (apply-text-conversion-solution state (:pred instr))

          "atom_chars/2"
          (apply-text-conversion-solution state (:pred instr))

          "atom_string/2"
          (apply-atom-string-solution state (:pred instr))

          "atom_number/2"
          (apply-atom-number-solution state)

          "upcase_atom/2"
          (apply-atom-case-solution state (:pred instr))

          "downcase_atom/2"
          (apply-atom-case-solution state (:pred instr))

          "atomic_list_concat/2"
          (apply-atomic-list-concat-solution state (:pred instr))

          "atomic_list_concat/3"
          (apply-atomic-list-concat-solution state (:pred instr))

          "string_to_atom/2"
          (apply-atom-string-solution state (:pred instr))

          "string_codes/2"
          (apply-text-conversion-solution state (:pred instr))

          "string_chars/2"
          (apply-text-conversion-solution state (:pred instr))

          "number_codes/2"
          (apply-text-conversion-solution state (:pred instr))

          "number_chars/2"
          (apply-text-conversion-solution state (:pred instr))

          "char_code/2"
          (apply-char-code-solution state)

          "string_code/3"
          (apply-string-code-solution state)

          "split_string/4"
          (apply-split-string-solution state)

          "char_type/2"
          (apply-char-type-solution state)

          "atom_concat/3"
          (apply-atom-concat-solution state)

          "string_concat/3"
          (apply-atom-concat-solution state)

          "atom_length/2"
          (apply-atom-length-solution state)

          "string_length/2"
          (apply-atom-length-solution state)

          "sub_atom/5"
          (apply-sub-atom-solution state (inc (:pc state)))

          "maplist/2"
          (apply-maplist-solution state 1)

          "maplist/3"
          (apply-maplist-solution state 2)

          "maplist/4"
          (apply-maplist-solution state 3)

          "predsort/3"
          (apply-predsort-solution state)

          "!/0"
          (-> state
              (update :choice-points #(vec (take (:cut-bar state) %)))
              advance)

          (do (warn-unresolved "builtin-call" (:pred instr))
              (backtrack state)))

        :call
        (case (:pred instr)
          "variant/2"
          (apply-variant-solution state)

          "maplist/2"
          (apply-maplist-solution state 1)

          "maplist/3"
          (apply-maplist-solution state 2)

          "maplist/4"
          (apply-maplist-solution state 3)

          "predsort/3"
          (apply-predsort-solution state)

          (do (warn-unresolved "call" (:pred instr))
              (backtrack state)))

        :execute
        (case (:pred instr)
          "variant/2"
          (let [next-state (apply-variant-solution state)]
            (if (= :running (:status next-state))
              (succeed-state next-state)
              next-state))

          "maplist/2"
          (let [next-state (apply-maplist-solution state 1)]
            (if (= :running (:status next-state))
              (succeed-state next-state)
              next-state))

          "maplist/3"
          (let [next-state (apply-maplist-solution state 2)]
            (if (= :running (:status next-state))
              (succeed-state next-state)
              next-state))

          "maplist/4"
          (let [next-state (apply-maplist-solution state 3)]
            (if (= :running (:status next-state))
              (succeed-state next-state)
              next-state))

          "predsort/3"
          (let [next-state (apply-predsort-solution state)]
            (if (= :running (:status next-state))
              (succeed-state next-state)
              next-state))

          (do (warn-unresolved "execute" (:pred instr))
              (backtrack state)))

        :call-foreign
        (execute-foreign state instr)

        :cut-ite
        (-> state
            cut-ite-choice-points
            advance)

        :proceed
        (if (seq (:stack state))
          (let [[ret-pc next-state] (pop-call-stack (leave-call-barrier state))]
            (assoc next-state :pc ret-pc))
          (succeed-state state))

        (backtrack state)))))

(defn run-wam [state]
  (loop [s state]
    (case (:status s)
      :succeeded true
      :failed false
      (recur (step s)))))

;; run-wam answers only true/false, which is enough for a ground query and
;; nothing else: this state is immutable, so a caller that passed an unbound
;; variable in an argument register has no way to read the answer back once the
;; final state is discarded. (The JS WAM runtime mutates its state in place, so
;; its shims deref the argument cell afterwards.) run-wam-state keeps the door
;; open: the SUCCEEDING state, or nil on failure. Bindings are read with
;; deref-value over (:bindings state).
(def ^:dynamic *count-instrs* false)

(defn run-wam-state [state]
  (loop [s state]
    (case (:status s)
      :succeeded s
      :failed nil
      (let [s2 (step s)]
        (recur (if *count-instrs*
                 (assoc s2 :instr-count (inc (or (:instr-count s2) 0)))
                 s2))))))

(defn run-wam-predicate
  ([code labels start-pc regs]
   (run-wam-predicate code labels start-pc regs {} nil))
  ([code labels start-pc regs foreign-handlers]
   (run-wam-predicate code labels start-pc regs foreign-handlers nil))
  ([code labels start-pc regs foreign-handlers intern-context]
   (run-wam (new-state code labels start-pc regs foreign-handlers intern-context))))

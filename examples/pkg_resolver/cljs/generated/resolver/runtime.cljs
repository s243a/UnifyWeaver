(defn same-permutation-items? [state left right]
  (and (= (count left) (count right))
       (every? zero?
               (map #(term-compare state %1 %2)
                    (sort #(term-compare state %1 %2) left)
                    (sort #(term-compare state %1 %2) right)))))

(defn apply-permutation-solution [state]

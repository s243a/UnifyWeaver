      (some? list-items)
      (apply-first-foreign-solution base-state resume-pc
                                    (select-solution-results base-state list-items))

      (and (logic-var? list-value)
           (not (logic-var? elem))
           (not= elem ::unbound)
           (some? rest-items))
      (apply-first-foreign-solution base-state resume-pc

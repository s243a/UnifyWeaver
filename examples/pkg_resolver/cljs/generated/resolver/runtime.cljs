          (backtrack state)))

      (and (logic-var? list-value)
           (not (logic-var? elem))
           (not= elem ::unbound)
           (some? out-items)
           (not-any? #(term-identical? state % elem) out-items))
      (let [[ok next-state] (unify-values state list-value out)]
        (if ok
          (advance next-state)
          (backtrack state)))

      :else
      (backtrack state))))


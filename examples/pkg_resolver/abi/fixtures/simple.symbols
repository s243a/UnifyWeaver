# A binary-form .symbols with the simple cases: two sonames, an alt-dep line,
# a meta field, comments, a private (minimum 0) row, tilde and epoch minimums.
libsimple.so.1 libsimple1 #MINVER#
| libsimple1 (>> 1.2), libsimple1 (<< 1.3)
* Build-Depends-Package: libsimple-dev
 SIMPLE_1.0@SIMPLE_1.0 1.0
 simple_new@SIMPLE_1.2 1.2~rc1
 simple_old@SIMPLE_1.0 1:0.9-2
 _private_thing@SIMPLE_PRIVATE 0 1
libsimple-extra.so.0 libsimple1 #MINVER#
 extra_fn@Base 1.1
